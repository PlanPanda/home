---
import AnswerCard from './AnswerCard.astro';
import { cases } from './before-after-data';
const num = (i: number) => String(i + 1).padStart(2, '0');
const verb = (tag: string) => tag.split('· ')[1];
---

<section class="before-after" id="ref-before-after">
  <div class="shell">
    <header class="before-after-intro">
      <h2>งานเดิมที่ต้องทำเอง<br />ให้ Solid Plan ช่วยได้</h2>
      <p>เก็บข้อมูลลูกค้าไว้ในที่เดียว เพื่อให้ค้นหา เตรียมคำตอบ และบันทึกงานต่อได้จากบริบทเดิม</p>
    </header>
    <div class="ba-grid">
      <ol class="ba-steps">
        {cases.map((c, i) => <li class="ba-step" data-i={i}>
          <span class="ba-num">{num(i)}</span>
          <span class="ba-verb">ไม่ต้อง{verb(c.tag)}อีก</span>
          <h3>{c.title}</h3>
          <p>ถาม Solid Plan ว่า “{c.question}” แล้วตรวจคำตอบก่อนบันทึก</p>
          <div class="ba-inline"><img src={`/images/${c.image}`} alt={c.alt} width="1200" height="900" loading="lazy" /><AnswerCard item={c} compact /></div>
        </li>)}
      </ol>
      <!-- Desktop: one sticky stage; mobile shows .ba-inline instead. display:none keeps only one set exposed to screen readers. -->
      <div class="ba-stage">
        {cases.map((c, i) => <div class="ba-scene" data-i={i}>
          <img src={`/images/${c.image}`} alt={c.alt} width="1200" height="900" loading="lazy" />
          <div class="ba-card"><AnswerCard item={c} /></div>
        </div>)}
      </div>
    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('.ba-step, .ba-scene');
  const show = (i: string) => items.forEach((el) => el.classList.toggle('on', el.dataset.i === i));
  show('0');
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && show((e.target as HTMLElement).dataset.i!)), { rootMargin: '-45% 0px -45% 0px' });
  document.querySelectorAll('.ba-step').forEach((s) => io.observe(s));
</script>

<style>
  /* Warm off-white + softened ink, after whereisrussell.com / hult.edu: contrast without stark black-on-white. */
  .before-after { --ba-ink:#2b2b2b; --ba-muted:#5f5b53; --ba-dim:#bdb7aa; padding:110px 0; background:#f9f6eb; color:var(--ba-ink); scroll-margin-top:72px; }
  .before-after-intro { max-width:710px; }
  .before-after-intro h2 { margin:0; font-size:48px; line-height:1.35; font-weight:600; text-wrap:balance; }
  .before-after-intro p { margin:18px 0 0; color:var(--ba-muted); font-size:18px; line-height:1.7; }
  .ba-grid { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:64px; margin-top:24px; }
  .ba-steps { list-style:none; margin:0; padding:0; }
  .ba-step { min-height:72vh; display:flex; flex-direction:column; justify-content:center; }
  .ba-step > * { transition:color .4s; }
  .ba-step:not(.on) > :not(.ba-inline) { color:var(--ba-dim); }
  .ba-num { font-size:14px; font-weight:700; color:var(--ba-muted); }
  .ba-verb { margin-top:6px; font-size:15px; font-weight:600; color:#15734b; }
  .ba-step h3 { margin:8px 0 12px; font-size:32px; line-height:1.4; font-weight:600; }
  .ba-step p { margin:0; color:var(--ba-muted); font-size:17px; line-height:1.7; }
  .ba-inline { display:none; }
  .ba-stage { position:sticky; top:calc(50vh - 240px); height:520px; }
  .ba-scene { position:absolute; inset:0; opacity:0; transform:translateY(16px); transition:opacity .5s, transform .5s; }
  .ba-scene.on { opacity:1; transform:none; }
  .ba-scene img { display:block; width:78%; height:auto; aspect-ratio:4/3; object-fit:cover; border-radius:12px; filter:saturate(.75); }
  .ba-card { position:absolute; right:0; bottom:0; width:58%; transform:translateY(24px); transition:transform .6s .1s; }
  .ba-scene.on .ba-card { transform:none; }
  @media (max-width:900px) {
    .ba-grid { grid-template-columns:1fr; gap:0; }
    .ba-stage { display:none; }
    .ba-step { min-height:0; padding:40px 0 0; }
    .ba-step:not(.on) > :not(.ba-inline) { color:inherit; }
    .ba-step:not(.on) .ba-verb { color:#15734b; }
    .ba-step:not(.on) p, .ba-step:not(.on) .ba-num { color:var(--ba-muted); }
    .ba-inline { display:block; position:relative; margin-top:20px; padding-bottom:110px; }
    .ba-inline img { display:block; width:85%; height:auto; aspect-ratio:4/3; object-fit:cover; border-radius:10px; }
    .ba-inline :global(.answer-card) { position:absolute; right:0; bottom:0; width:78%; }
  }
  @media (max-width:700px) { .before-after { padding-block:78px; }.before-after-intro h2 { font-size:40px; }.ba-step h3 { font-size:27px; } }
  @media (max-width:480px) { .before-after-intro h2 { font-size:32px; }.ba-step h3 { font-size:24px; }.ba-inline img { width:100%; }.ba-inline :global(.answer-card) { width:92%; } .ba-inline { padding-bottom:150px; } }
  @media (prefers-reduced-motion:reduce) { .ba-step > *,.ba-scene,.ba-card { transition:none; } }
</style>
