---
/* Icons: Lucide (https://lucide.dev) — same set the Solid Plan app uses. */
const svg = (paths: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${paths}</svg>`;

const ICONS: Record<string, string> = {
  sparkles: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>',
  circleDollarSign: '<circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path>',
  banknote: '<rect width="20" height="12" x="2" y="6" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path>',
  heartPulse: '<path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path><path d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path>',
  messageCircle: '<path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"></path>',
  cake: '<path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"></path><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"></path><path d="M2 21h20"></path><path d="M7 8v3"></path><path d="M12 8v3"></path><path d="M17 8v3"></path><path d="M7 4h.01"></path><path d="M12 4h.01"></path><path d="M17 4h.01"></path>',
  bellRing: '<path d="M10.268 21a2 2 0 0 0 3.464 0"></path><path d="M22 8c0-2.3-.8-4.3-2-6"></path><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path><path d="M4 2C2.8 3.7 2 5.7 2 8"></path>',
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>',
  clock: '<path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle>',
  database: '<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path>',
  clipboardCheck: '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path>',
  plus: '<path d="M5 12h14"></path><path d="M12 5v14"></path>',
  arrowUp: '<path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path>',
};

const cases = [
  {
    tag: '01 · จดเอง',
    title: 'ได้กรมธรรม์มาแล้ว ต้องนั่งพิมพ์ลงฟอร์มเองทีละช่อง',
    image: 'before-transcription.jpg',
    alt: 'กรมธรรม์และคอมพิวเตอร์สำหรับกรอกข้อมูลทีละช่อง',
    question: 'เพิ่มกรมธรรม์จากไฟล์แนบให้คุณกานต์',
    heading: 'ข้อมูลที่อ่านได้ พร้อมให้ตรวจสอบ',
    rows: [['shield', 'แบบประกัน', 'ตลอดชีพ ชำระเบี้ย 20 ปี'], ['circleDollarSign', 'ทุนประกัน', '1,000,000 บาท'], ['banknote', 'เบี้ยประกัน', '24,000 บาท / ปี']],
    noteIcon: 'clock',
    note: 'รอยืนยัน · ยังไม่ได้บันทึก',
  },
  {
    tag: '02 · ค้นเอง',
    title: 'อยากรู้ข้อมูลลูกค้า ต้องไล่หาจากหลายที่',
    image: 'before-search.jpg',
    alt: 'หน้าจอ Windows ที่ข้อมูลลูกค้ากระจายอยู่ใน LINE, Excel และ Notes ด้วยข้อมูลสมมติ',
    question: 'คุณกานต์มีกรมธรรม์อะไรบ้าง?',
    heading: 'คุณกานต์ พูนสุข · พบ 2 กรมธรรม์',
    rows: [['shield', 'ตลอดชีพ', 'เบี้ย 24,000 บาท / ปี'], ['heartPulse', 'สุขภาพ', 'เบี้ย 18,500 บาท / ปี'], ['messageCircle', 'คุยล่าสุด', 'สนใจเพิ่มความคุ้มครองโรคร้ายแรง']],
    noteIcon: 'database',
    note: 'สรุปจากข้อมูลลูกค้าและกรมธรรม์',
  },
  {
    tag: '03 · ป้อนข้อมูลให้ AI',
    title: 'อยากให้ AI ช่วย ต้องก๊อปข้อมูลไปวางทุกครั้ง',
    image: 'before-ai-input.jpg',
    alt: 'หน้าจอ Mac ที่กำลังลากไฟล์ Excel และ TXT จำนวนมากเข้าแชต AI ด้วยข้อมูลสมมติ',
    question: 'เดือนนี้ใครเกิด และสัปดาห์นี้ควรติดต่อใคร?',
    heading: 'ค้นจากลูกค้า 312 ราย',
    rows: [['cake', 'วันเกิดเดือนนี้', '5 ราย'], ['bellRing', 'ควรติดตามสัปดาห์นี้', '3 ราย'], ['user', 'คุณวิชัย', 'ติดตามใบเสนอราคา']],
    noteIcon: 'clipboardCheck',
    note: 'ตรวจทานวันสำคัญและประวัติก่อนติดต่อ',
  },
];
---

<section class="before-after" id="ref-before-after">
  <div class="shell">
    <header class="before-after-intro">
      <h2>งานเดิมที่ต้องทำเอง<br />ให้ Solid Plan ช่วยได้</h2>
      <p>เก็บข้อมูลลูกค้าไว้ในที่เดียว เพื่อให้ค้นหา เตรียมคำตอบ และบันทึกงานต่อได้จากบริบทเดิม</p>
    </header>
    {cases.map((item) => <article class="comparison-case">
      <span class="comparison-tag">{item.tag}</span>
      <h3>{item.title}</h3>
      <div class="comparison-labels" aria-hidden="true"><span>ทำงานแบบเดิม</span><span>กับ Solid Plan</span></div>
      <div class="comparison-screens">
        <img src={`/images/${item.image}`} alt={item.alt} width="1200" height="900" loading="lazy" />
        <section class="comparison-product" aria-label={`ตัวอย่าง ${item.heading} ใน Solid Plan`}>
          <header><img src="/brand/logo-192.png" alt="" width="20" height="20" /><b>Solid Plan</b></header>
          <div class="comparison-product-body">
            <p class="comparison-question">{item.question}</p>
            <div class="comparison-answer">
              <strong><span class="answer-badge" aria-hidden="true"><Fragment set:html={svg(ICONS.sparkles)} /></span>{item.heading}</strong>
              <dl>{item.rows.map(([iconName, label, value]) => <div><dt><Fragment set:html={svg(ICONS[iconName])} />{label}</dt><dd>{value}</dd></div>)}</dl>
              <small><Fragment set:html={svg(ICONS[item.noteIcon])} />{item.note}</small>
            </div>
            <div class="comparison-composer"><span class="comparison-add" aria-hidden="true"><Fragment set:html={svg(ICONS.plus)} /></span><span class="comparison-ph">ถามผู้ช่วย AI…</span><span class="comparison-send" aria-hidden="true"><Fragment set:html={svg(ICONS.arrowUp)} /></span></div>
          </div>
        </section>
      </div>
    </article>)}
  </div>
</section>

<style>
  .before-after { padding:110px 0; background:var(--ref-soft); scroll-margin-top:72px; }
  .before-after-intro { max-width:710px; }
  .before-after-intro h2 { margin:0; font-size:48px; line-height:1.35; font-weight:600; text-wrap:balance; }
  .before-after-intro p { margin:18px 0 0; color:#6e6e73; font-size:18px; line-height:1.7; }
  .comparison-case { margin-top:82px; }
  .comparison-case + .comparison-case { padding-top:82px; border-top:1px solid #dcdce1; }
  .comparison-tag { display:inline-flex; margin-bottom:14px; padding:5px 12px; border:1px solid #d2d2d7; border-radius:999px; color:#6e6e73; font-size:12.5px; font-weight:600; }
  .comparison-case h3 { max-width:760px; margin:0 0 26px; font-size:32px; line-height:1.35; font-weight:600; }
  .comparison-labels,.comparison-screens { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); }
  .comparison-labels { margin-bottom:12px; color:#525258; font-size:14px; font-weight:600; }
  .comparison-labels span { padding:0 18px; }
  .comparison-labels span + span { border-left:1px solid #d2d2d7; }
  .comparison-screens { overflow:hidden; border:1px solid #d2d2d7; border-radius:8px; background:#fff; }
  .comparison-screens > img { display:block; width:100%; height:100%; aspect-ratio:4 / 3; object-fit:cover; background:#fff; }
  .comparison-product { min-width:0; border-left:1px solid #d2d2d7; background:#fff; display:flex; flex-direction:column; }
  .comparison-product > header { display:flex; align-items:center; gap:8px; padding:10px 14px; border-bottom:1px solid #ececf0; font-size:12px; }
  .comparison-product > header small { margin-left:auto; color:#6e6e73; font-size:10px; }
  .comparison-product-body { min-height:0; flex:1; display:flex; flex-direction:column; padding:16px; }
  .comparison-question { align-self:flex-end; max-width:92%; margin:0 0 16px; padding:8px 12px; border-radius:8px; background:#f1f1f3; font-size:12px; line-height:1.6; }
  .comparison-answer { margin-bottom:16px; padding:12px 14px; border:1px solid #ececf0; border-radius:14px; background:#fafafa; font-size:12px; line-height:1.5; }
  .comparison-answer > strong { display:flex; align-items:center; gap:7px; font-size:14px; }
  .answer-badge { flex:none; display:grid; place-items:center; width:18px; height:18px; border-radius:6px; background:#1d1d1f; color:#fff; }
  .answer-badge :global(svg) { width:11px; height:11px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .comparison-answer dl { margin:10px 0; }
  .comparison-answer dl > div { display:grid; grid-template-columns:1fr 1.45fr; gap:10px; padding:6px 0; border-bottom:1px solid #ececf0; }
  .comparison-answer dt { display:flex; align-items:center; gap:6px; }
  .comparison-answer dt :global(svg) { flex:none; width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .comparison-answer dt,.comparison-answer small { color:#6e6e73; }
  .comparison-answer dd { margin:0; }
  .comparison-answer small { display:flex; align-items:center; gap:6px; font-size:10px; }
  .comparison-answer small :global(svg) { flex:none; width:11px; height:11px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .comparison-composer { display:flex; align-items:center; gap:10px; margin-top:auto; padding:8px 12px; border:1px solid #d2d2d7; border-radius:8px; color:#6e6e73; font-size:11px; }
  .comparison-add { flex:none; display:grid; place-items:center; width:20px; height:20px; border:1px solid #d2d2d7; border-radius:50%; background:#fff; color:#1d1d1f; }
  .comparison-add :global(svg) { width:10px; height:10px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .comparison-ph { flex:1; }
  .comparison-send { width:20px; height:20px; flex:none; display:grid; place-items:center; border-radius:50%; background:#1d1d1f; color:#fff; }
  .comparison-send :global(svg) { width:11px; height:11px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  @media (max-width:700px) { .before-after { padding-block:78px; }.before-after-intro h2 { font-size:40px; }.comparison-case { margin-top:60px; }.comparison-case + .comparison-case { padding-top:60px; }.comparison-case h3 { font-size:27px; }.comparison-labels,.comparison-screens { grid-template-columns:1fr; }.comparison-labels span { padding:0; }.comparison-labels span + span { display:none; }.comparison-screens { gap:0; }.comparison-product { border-left:0; border-top:1px solid #d2d2d7; min-height:330px; }.comparison-screens > img { height:auto; aspect-ratio:auto; } }
  @media (max-width:480px) { .before-after-intro h2 { font-size:32px; }.comparison-case h3 { font-size:24px; }.comparison-product-body { padding:13px; }.comparison-question,.comparison-answer { font-size:11px; }.comparison-answer dl > div { grid-template-columns:1fr 1.25fr; gap:6px; }.comparison-product { min-height:292px; } }
</style>
