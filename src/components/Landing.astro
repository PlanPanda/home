        const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
        const down = () => { cThread.scrollTop = cThread.scrollHeight; };
        const el = (tag, cls) => { const n = document.createElement(tag); if (cls) n.className = cls; return n; };
        const avatarEl = () => { const t = document.createElement("template"); t.innerHTML = AVATAR.trim(); return t.content.firstChild; };
        const fromHTML = (html) => { const t = document.createElement("template"); t.innerHTML = html.trim(); return t.content.firstChild; };
        const composerText = document.querySelector("[data-composer-text]");
        const composerFile = document.querySelector("[data-composer-file]");
        const scenarioButtons = [...document.querySelectorAll("[data-ref-scenario]")];
        const demoTimer = document.querySelector("[data-demo-timer]");
        const syncScenarioButtons = (key, waiting = false) => {
          scenarioButtons.forEach((item) => {
            const active = item.getAttribute("data-ref-scenario") === key;
            item.setAttribute("aria-pressed", String(active));
          });
          demoTimer?.classList.toggle("is-running", waiting);
        };
        const resetComposer = () => {
          if (composerText) { composerText.textContent = "ถามผู้ช่วย AI…"; composerText.classList.remove("typing"); }
          if (composerFile) composerFile.hidden = true;
        };

        const appBody = document.querySelector("[data-app-body]");
        const dockEl = document.querySelector("[data-dock]");
        const composerBox = dockEl ? dockEl.querySelector(".app-composer") : null;
        let chatting = false;
        let dockTimer = 0;
        // Apple-Messages-style dock move: the composer starts centered over the
        // welcome hero, then glides down to the bottom dock once a message is
        // sent and the conversation takes over from the top
        const setChat = (toChat) => new Promise((resolve) => {
          if (!appBody || !dockEl || !composerBox) {
            appBody?.classList.toggle("chatting", toChat);
            chatting = toChat;
            resolve();
            return;
          }
          // drop any leftover glide so measurements are layout-accurate
          window.clearTimeout(dockTimer);
          dockEl.style.transition = "none";
          dockEl.style.transform = "";
          void dockEl.offsetHeight;
          const from = composerBox.getBoundingClientRect().top;
          appBody.classList.toggle("chatting", toChat);
          chatting = toChat;
          const dy = from - composerBox.getBoundingClientRect().top;
          if (reduce || !dy) { resolve(); return; }
          dockEl.style.transform = `translateY(${dy}px)`;
          void dockEl.offsetHeight;
          dockEl.style.transition = "transform .62s cubic-bezier(.3,1.08,.34,1)";
          dockEl.style.transform = "translateY(0)";
          dockTimer = window.setTimeout(() => { dockEl.style.transition = ""; dockEl.style.transform = ""; resolve(); }, 660);
        });

        async function playScenario(key) {
          demoObserver?.disconnect();
          activeKey = key;
          const sc = SCENARIOS[key];
          if (!sc) return;
          const id = ++runId;
          window.clearTimeout(cycleTimer);
          syncScenarioButtons(key);
          cThread.innerHTML = "";
          resetComposer();
          await setChat(false);
          if (id !== runId) return;
          await sleep(reduce ? 0 : 500); if (id !== runId) return;

          // the question is typed in the composer at the bottom, like a real chat
          if (composerText) {
            composerText.textContent = "";
            composerText.classList.add("typing");
            if (sc.file && composerFile) { composerFile.innerHTML = ICONS.file + sc.file; composerFile.hidden = false; }
            if (reduce) composerText.textContent = sc.user;
            else for (const ch of Array.from(sc.user)) { if (id !== runId) return; composerText.textContent += ch; await sleep(15); }
            await sleep(reduce ? 0 : 320); if (id !== runId) return;
            resetComposer();
          }

          // sent: the bubble appears at the top of the thread while the
          // composer glides down to dock at the bottom
          await setChat(true);
          if (id !== runId) return;
          const user = el("div", "msg-user");
          if (sc.file) { const f = el("span", "msg-file"); f.innerHTML = ICONS.file + sc.file; user.appendChild(f); }
          const text = el("span");
          text.textContent = sc.user;
          user.appendChild(text);
          cThread.appendChild(user);
          down();
          await sleep(reduce ? 0 : 380); if (id !== runId) return;

          const thinkRow = el("div", "ref-avatar-row");
          const thinking = avatarEl(); thinking.setAttribute("data-state", "thinking");
          thinkRow.appendChild(thinking);
          cThread.appendChild(thinkRow); down();
          await sleep(850); if (id !== runId) return;
          thinkRow.remove();

          const work = el("button", "work");
          work.type = "button"; work.setAttribute("aria-expanded", "false");
          work.innerHTML = '<span class="spin"></span><span>กำลังทำงาน…</span>';
          cThread.appendChild(work); down();
          await sleep(780); if (id !== runId) return;
          work.innerHTML = ICONS.check + `<span>เสร็จสิ้น · ${sc.steps.length} ขั้นตอน</span>` + ICONS.chev;
          const list = el("ul", "steps");
          sc.steps.forEach((s) => { const li = document.createElement("li"); li.textContent = s; list.appendChild(li); });
          list.hidden = !reduce;
          work.setAttribute("aria-expanded", String(reduce));
          work.after(list);
          work.addEventListener("click", () => {
            const open = work.getAttribute("aria-expanded") === "true";
            work.setAttribute("aria-expanded", String(!open));
            list.hidden = open; down();
          });
          await sleep(320); if (id !== runId) return;

          const card = fromHTML(sc.html);
          cThread.appendChild(card);
          requestAnimationFrame(() => card.classList.add("in"));

          const avatar = avatarEl();
          avatar.setAttribute("data-state", sc.needsConfirm ? "waiting" : "normal");
          const row = el("div", "ref-avatar-row");
          row.appendChild(avatar);
          const note = el("span", "ref-avatar-note");
          note.textContent = sc.needsConfirm ? "รอยืนยัน" : "จากข้อมูลในระบบ";
          row.appendChild(note);
          cThread.appendChild(row);
          if (sc.needsConfirm) cThread.scrollTop += card.getBoundingClientRect().top - cThread.getBoundingClientRect().top - 12;
          else down();

          const confirmBtn = card.querySelector("[data-confirm-action]");
          const cancelBtn = card.querySelector("[data-cancel-action]");
          if (confirmBtn) confirmBtn.addEventListener("click", () => {
            window.clearTimeout(cycleTimer); autoplay = false; updateToggle();
            if (id !== runId) return;
            const doneWrap = el("div");
            doneWrap.innerHTML = sc.done.trim();
            while (doneWrap.firstChild) card.parentNode.insertBefore(doneWrap.firstChild, card);
            card.remove();
            note.textContent = "บันทึกแล้ว";
            avatar.setAttribute("data-state", "success");
            setTimeout(() => { if (id === runId && avatar.isConnected) avatar.setAttribute("data-state", "normal"); }, 2400);
            down();
          });
          if (cancelBtn) cancelBtn.addEventListener("click", () => {
            window.clearTimeout(cycleTimer); autoplay = false; updateToggle();
            const status = card.querySelector("[data-card-status]");
            if (status) { status.hidden = false; status.textContent = "ยกเลิกแล้ว · ยังไม่มีการบันทึกข้อมูล"; }
            confirmBtn?.setAttribute("disabled", "");
            cancelBtn.setAttribute("disabled", "");
            note.textContent = "ยังไม่ได้บันทึก";
            avatar.setAttribute("data-state", "normal");
          });

          const nextKey = scenarioKeys[(scenarioKeys.indexOf(key) + 1) % scenarioKeys.length];
          const waitTime = 4000;
          demoTimer?.style.setProperty("--scenario-duration", `${waitTime}ms`);
          syncScenarioButtons(key, autoplay);
          if (autoplay) cycleTimer = window.setTimeout(() => {
            if (id === runId) playScenario(nextKey);
          }, waitTime);
        }

        const toggle = document.querySelector("[data-demo-toggle]");
        const updateToggle = () => {
          const label = autoplay ? "หยุดเล่นอัตโนมัติ" : "เล่นอัตโนมัติ";
          toggle?.setAttribute("aria-pressed", String(autoplay));
          toggle?.setAttribute("aria-label", label);
          toggle?.setAttribute("title", label);
          syncScenarioButtons(activeKey, false);
        };
        toggle?.addEventListener("click", () => { autoplay = !autoplay; window.clearTimeout(cycleTimer); updateToggle(); if (autoplay) playScenario(activeKey); });
        updateToggle();
        const pauseForReading = () => { autoplay = false; window.clearTimeout(cycleTimer); updateToggle(); };
        cThread.addEventListener("pointerdown", pauseForReading);
        cThread.addEventListener("focusin", pauseForReading);
        scenarioButtons.forEach((button) => button.addEventListener("click", () => {
          autoplay = false; updateToggle();
          playScenario(button.getAttribute("data-ref-scenario"));
        }));
        document.querySelectorAll("[data-chip]").forEach((button) => button.addEventListener("click", () => {
          autoplay = false; window.clearTimeout(cycleTimer); updateToggle();
          playScenario(button.getAttribute("data-chip"));
        }));

        const ipad = document.querySelector(".ipad");
        if (reduce || !("IntersectionObserver" in window) || !ipad) {
          playScenario("upload");
        } else {
          demoObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => { if (entry.isIntersecting) playScenario("upload"); });
          }, { threshold: 0.35 });
          demoObserver.observe(ipad);
        }
      }
    </script>

