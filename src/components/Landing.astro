---
const APP_LOGIN = "https://app.solidplan.ai/login";
const APP_SIGNUP = "https://app.solidplan.ai/signup";

const COMMON_FEATURES = [
  "บันทึกนัดหมายพื้นฐาน",
  "จัดเก็บไฟล์ของลูกค้า",
  "สถิติผลงานแบบละเอียด",
  "ระบบจัดการทีม (Soon)",
  "ปฏิทินกิจกรรม (Soon)",
  "ใช้งานบน iPad/Desktop",
];

const PLANS = [
  {
    name: "Trial",
    price: "0",
    priceMonthly: "0",
    period: "/วัน",
    description: "เริ่มต้นใช้งานฟรี",
    customerLimit: "สูงสุด 10 ราย",
    highlighted: false,
    badge: null,
  },
  {
    name: "Starter",
    price: "10",
    priceMonthly: "~300",
    period: "/วัน",
    description: "สำหรับตัวแทนเริ่มโต",
    customerLimit: "สูงสุด 200 ราย",
    highlighted: true,
    badge: "แนะนำ",
  },
  {
    name: "Pro",
    price: "20",
    priceMonthly: "~600",
    period: "/วัน",
    description: "ระบบที่ดีที่สุดสำหรับมืออาชีพ",
    customerLimit: "สูงสุด 1,000 ราย",
    highlighted: false,
    badge: null,
  },
];
---

<style is:global>
  /* ===== OVERDRIVE: Animated Hero Gradient Mesh ===== */
  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(255, 77, 139, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(255, 140, 105, 0.06) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 80%, rgba(160, 140, 255, 0.05) 0%, transparent 50%);
    animation: meshShift 20s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes meshShift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(2%, -1%) scale(1.05); }
    50% { transform: translate(-1%, 2%) scale(1); }
    75% { transform: translate(-2%, -1%) scale(1.03); }
  }

  /* ===== OVERDRIVE: Scroll Reveal ===== */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
                transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== OVERDRIVE: Spring Hover ===== */
  .spring-hover {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .spring-hover:hover {
    transform: translateY(-4px) scale(1.02);
  }

  .feature-card:hover {
    transform: translateY(-6px) scale(1.02);
  }

  /* ===== OVERDRIVE: Breathing Glow ===== */
  .plan-highlighted {
    animation: breatheGlow 3s ease-in-out infinite;
  }

  @keyframes breatheGlow {
    0%, 100% { box-shadow: 0 8px 40px rgba(255, 77, 139, 0.12); }
    50% { box-shadow: 0 8px 60px rgba(255, 77, 139, 0.22), 0 0 80px rgba(255, 77, 139, 0.06); }
  }

  /* ===== OVERDRIVE: iPad Float ===== */
  .ipad-float {
    animation: ipadFloat 6s ease-in-out infinite;
  }

  @keyframes ipadFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ===== OVERDRIVE: Nav Scroll ===== */
  .nav-solid {
    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.06);
  }

  /* ===== OVERDRIVE: Reduced Motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .hero-gradient,
    .plan-highlighted,
    .ipad-float {
      animation: none !important;
    }
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .spring-hover,
    .feature-card {
      transition: none !important;
    }
    .spring-hover:hover,
    .feature-card:hover {
      transform: none !important;
    }
  }
</style>

<!-- ===== NAV ===== -->
<nav
  class="sticky top-0 z-50 bg-canvas/85 backdrop-blur-xl border-b border-hairline/50 transition-shadow duration-300"
  data-nav
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 no-underline text-ink">
      <img
        src="/favicon/web-app-manifest-512x512.png"
        alt="Solid Plan"
        width="32"
        height="32"
        class="rounded-lg"
      />
      <span class="text-lg font-bold tracking-tight">Solid Plan</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a
        href="#features"
        class="text-sm font-medium text-muted hover:text-ink transition no-underline"
        >ฟีเจอร์</a
      >
      <a
        href="#trust"
        class="text-sm font-medium text-muted hover:text-ink transition no-underline"
        >ความไว้วางใจ</a
      >
      <a
        href="#pricing"
        class="text-sm font-medium text-muted hover:text-ink transition no-underline"
        >ราคา</a
      >
      <a
        href="#showcase"
        class="text-sm font-medium text-muted hover:text-ink transition no-underline"
        >iPad App</a
      >
    </div>

    <div class="hidden md:flex items-center gap-4">
      <a href={APP_LOGIN} class="text-sm font-semibold text-ink no-underline"
        >เข้าสู่ระบบ</a
      >
      <a
        href={APP_SIGNUP}
        class="bg-ink text-white text-sm font-semibold px-5 py-2.5 rounded-xl no-underline hover:bg-ink/80 transition active:scale-95"
        >ทดลองใช้ฟรี</a
      >
    </div>

    <button class="md:hidden p-1" id="menuToggle" aria-label="เปิดเมนู">
      <i class="fa-solid fa-bars text-lg"></i>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    class="hidden md:hidden flex-col px-6 pb-4 gap-1 border-t border-hairline/50"
    id="mobileMenu"
  >
    <a
      href="#features"
      class="py-3 text-sm font-medium text-ink no-underline border-b border-hairline/30"
      >ฟีเจอร์</a
    >
    <a
      href="#trust"
      class="py-3 text-sm font-medium text-ink no-underline border-b border-hairline/30"
      >ความไว้วางใจ</a
    >
    <a
      href="#pricing"
      class="py-3 text-sm font-medium text-ink no-underline border-b border-hairline/30"
      >ราคา</a
    >
    <a
      href="#showcase"
      class="py-3 text-sm font-medium text-ink no-underline border-b border-hairline/30"
      >iPad App</a
    >
    <a
      href={APP_SIGNUP}
      class="mt-3 bg-ink text-white text-sm font-semibold px-5 py-3 rounded-xl text-center no-underline"
      >ทดลองใช้ฟรี</a
    >
  </div>
</nav>

<!-- ===== HERO ===== -->
<section class="relative overflow-hidden">
  <div class="hero-gradient" aria-hidden="true"></div>
  <div
    class="relative z-10 max-w-7xl mx-auto px-6 pt-14 pb-20 md:pt-28 md:pb-32"
  >
    <div class="grid md:grid-cols-12 gap-8 items-center">
      <div class="md:col-span-7 order-2 md:order-1" data-parallax-content>
        <div
          class="inline-flex items-center gap-2 bg-surface-card px-4 py-2 rounded-full text-sm font-medium text-body mb-8"
        >
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          สำหรับตัวแทนประกันภัยมืออาชีพ
        </div>

        <h1
          class="text-[44px] md:text-[64px] font-bold leading-[1.3] tracking-tight mb-6"
        >
          รายได้ที่ดี
          <br class="lg:hidden" />
          <span class="text-brand-pink">มาจากแผนที่ดี</span>
          <br class="lg:hidden" />
          <br class="hidden lg:block" />
          และ <span id="typingTarget" class="inline-block min-w-[2ch]"></span>
        </h1>

        <p class="text-lg md:text-xl text-body leading-relaxed mb-10 max-w-xl">
          Solid Plan ช่วยคุณจัดการลูกค้า วางแผนงาน และติดตามผลงาน
          เพื่อให้คุณโตอย่างเป็นระบบ ออกแบบมาเพื่อตัวแทนประกันมืออาชีพโดยเฉพาะ
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={APP_SIGNUP}
            class="bg-ink text-white text-base font-semibold px-8 py-4 rounded-2xl flex items-center justify-center gap-2 no-underline hover:bg-ink/80 transition active:scale-95"
          >
            เริ่มต้นใช้งานฟรี
            <i class="fa-solid fa-chevron-right text-sm"></i>
          </a>
          <a
            href="#showcase"
            class="bg-white/60 text-ink text-base font-semibold px-8 py-4 rounded-2xl flex items-center justify-center gap-2.5 no-underline hover:bg-white/80 transition"
          >
            <i class="fa-solid fa-play text-sm"></i>
            รู้จักเราเพิ่มเติม
          </a>
        </div>

        <p class="mt-4 text-sm text-muted">
          <i class="fa-solid fa-lock text-brand-pink mr-2" aria-hidden="true"></i>
          ข้อมูลของคุณถูกเข้ารหัสและจัดเก็บตามมาตรฐานสากล
        </p>
      </div>

      <div class="hidden md:block md:col-span-5 order-2" data-parallax-image>
        <img
          src="/images/comic_w.png"
          alt="ตัวแทนประกันมืออาชีพกับ Solid Plan"
          class="w-full h-135 lg:h-140 object-cover object-top drop-shadow-lg lg:drop-shadow-none"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<!-- ===== FEATURES ===== -->
<section
  id="features"
  class="max-w-7xl mx-auto px-6 pb-28 md:pb-36 scroll-mt-20"
>
  <div class="grid md:grid-cols-3 gap-6">
    <!-- Customer Management -->
    <div
      class="bg-brand-pink text-white p-10 rounded-3xl flex flex-col justify-between min-h-105 reveal spring-hover feature-card"
      data-reveal-delay="0"
    >
      <div>
        <div
          class="bg-white/20 w-12 h-12 rounded-xl flex items-center justify-center mb-6"
        >
          <i class="fa-solid fa-users text-xl"></i>
        </div>
        <h3 class="text-2xl font-semibold mb-4 leading-tight">
          จัดการลูกค้า (CRM)
        </h3>
        <p class="opacity-90 leading-relaxed">
          เก็บข้อมูลลูกค้าอย่างเป็นระเบียบ
          พร้อมระบบวิเคราะห์ความต้องการแบบละเอียด ช่วยให้ปิดการขายได้ง่ายขึ้น
        </p>
      </div>
      <div class="mt-8 pt-8 border-t border-white/20">
        <span class="text-xs font-bold tracking-[0.15em] uppercase opacity-70"
          >Customer Insights</span
        >
      </div>
    </div>

    <!-- Smart Planning -->
    <div
      class="bg-brand-teal text-white p-10 rounded-3xl flex flex-col justify-between min-h-105 reveal spring-hover feature-card"
      data-reveal-delay="100"
    >
      <div>
        <div
          class="bg-white/10 w-12 h-12 rounded-xl flex items-center justify-center mb-6"
        >
          <i class="fa-solid fa-calendar-days text-xl"></i>
        </div>
        <h3 class="text-2xl font-semibold mb-4 leading-tight">
          วางแผนงานแม่นยำ
        </h3>
        <p class="opacity-80 leading-relaxed">
          จัดตารางนัดหมายและติดตามผลงานในหน้าเดียว เห็นเป้าหมาย FYP/FYC
          ชัดเจนในทุกสัปดาห์
        </p>
      </div>
      <div class="mt-8 pt-8 border-t border-white/10">
        <span class="text-xs font-bold tracking-[0.15em] uppercase opacity-60"
          >Planning & Results</span
        >
      </div>
    </div>

    <!-- Team Management -->
    <div
      class="bg-brand-lavender text-ink p-10 rounded-3xl flex flex-col justify-between min-h-105 reveal spring-hover feature-card"
      data-reveal-delay="200"
    >
      <div>
        <div
          class="bg-white/40 w-12 h-12 rounded-xl flex items-center justify-center mb-6"
        >
          <i class="fa-solid fa-chart-simple text-xl"></i>
        </div>
        <h3 class="text-2xl font-semibold mb-4 leading-tight">
          บริหารทีมอย่างโปร
        </h3>
        <p class="opacity-80 leading-relaxed">
          เชื่อมต่อกับลูกทีม ติดตามความคืบหน้า
          และแชร์ข้อมูลกันได้อย่างปลอดภัยในระบบเดียว
        </p>
      </div>
      <div class="mt-8 pt-8 border-t border-black/10">
        <span class="text-xs font-bold tracking-[0.15em] uppercase opacity-50"
          >Team Management</span
        >
      </div>
    </div>
  </div>
</section>

<!-- ===== TRUST SECTION ===== -->
<section
  id="trust"
  class="max-w-7xl mx-auto px-6 pb-28 md:pb-36 scroll-mt-20"
>
  <div class="reveal rounded-[36px] bg-surface-soft border border-hairline/60 p-8 md:p-12">
    <div class="grid md:grid-cols-12 gap-8 md:gap-10 items-center">
      <div class="md:col-span-8">
        <p class="text-xs font-bold tracking-[0.15em] uppercase text-muted-soft mb-4">
          TRUST CENTER
        </p>
        <h2 class="text-3xl md:text-5xl font-semibold tracking-tight leading-tight mb-6">
          ดูแลความสัมพันธ์ของคุณ
          <br class="hidden md:block" />
          บนมาตรฐานความปลอดภัยระดับสถาบันการเงิน
        </h2>
        <p class="text-lg text-body leading-relaxed mb-6">
          Solid Plan ถูกสร้างบนโครงสร้างพื้นฐานจากผู้ให้บริการระดับโลก
          (Railway) ที่ผ่านมาตรฐาน SOC 2 และ HIPAA ซึ่งเป็นมาตรฐานเดียวกับที่
          โรงพยาบาลและสถาบันการเงินชั้นนำในสหรัฐฯ ใช้ เพื่อให้คุณมั่นใจว่า
          ข้อมูลลูกค้าของคุณจะถูกดูแลในสภาพแวดล้อมที่ปลอดภัย
        </p>
        <a
          href="/security-privacy"
          class="inline-flex items-center gap-2 text-brand-pink font-semibold no-underline hover:underline"
        >
          ดูมาตรฐานความปลอดภัยและความเป็นส่วนตัว
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="md:col-span-4">
        <div class="bg-white rounded-3xl py-10 px-8 border border-hairline/60 flex flex-col items-center justify-center text-center">
          <div class="flex items-center justify-center gap-6 mb-6">
            <img src="/images/aicpa.svg" alt="SOC 2 Type II compliant" class="h-9 opacity-60 hover:opacity-100 transition-opacity" />
            <img src="/images/hippa.svg" alt="HIPAA compliant" class="h-9 opacity-60 hover:opacity-100 transition-opacity" />
          </div>
          <p class="text-sm text-muted leading-relaxed max-w-60">
            ปกป้องความลับของลูกค้าคุณ
            ด้วยมาตรฐานที่โลกยอมรับ
            เพื่อให้คุณสร้างความสัมพันธ์ได้อย่างสบายใจ
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== PRICING ===== -->
<section
  id="pricing"
  class="max-w-7xl mx-auto px-6 py-28 border-t border-black/5 scroll-mt-20"
>
  <!-- Headline -->
  <div class="text-center mb-6 reveal">
    <h2 class="text-4xl md:text-5xl font-semibold tracking-tight mb-4">
      เริ่มใช้ฟรีก่อน ค่อยเลือกแผนทีหลัง
    </h2>
    <p class="text-lg text-muted max-w-2xl mx-auto">
      สมัครใช้งานฟรีได้ทันที ไม่ต้องจ่ายเงินก่อน เมื่อพร้อมค่อยเลือกแพ็กเกจที่ใช่
    </p>
  </div>

  <!-- Trust pills -->
  <div class="flex flex-wrap justify-center gap-3 mb-16 reveal" data-reveal-delay="100">
    <div class="inline-flex items-center gap-2 bg-surface-card px-4 py-2 rounded-full text-sm text-body">
      <i class="fa-solid fa-rocket text-brand-pink"></i>
      <span>สมัครฟรี ไม่ต้องใช้บัตรเครดิต</span>
    </div>
    <div class="inline-flex items-center gap-2 bg-surface-card px-4 py-2 rounded-full text-sm text-body">
      <i class="fa-solid fa-mobile-screen text-brand-pink"></i>
      <span>เติมเงินรายวัน เหมือนมือถือ</span>
    </div>
    <div class="inline-flex items-center gap-2 bg-surface-card px-4 py-2 rounded-full text-sm text-body">
      <i class="fa-solid fa-arrow-right-arrow-left text-brand-pink"></i>
      <span>เปลี่ยนแผนได้ทุกวัน</span>
    </div>
  </div>

  <!-- Pricing Cards -->
  <div class="grid md:grid-cols-3 gap-6 lg:gap-8 items-start">
    {
      PLANS.map((plan, i) => (
        <div
          class={`reveal spring-hover relative bg-white rounded-3xl p-8 flex flex-col border-2 transition-all duration-300 ${
            plan.highlighted
              ? "plan-highlighted border-brand-pink shadow-[0_8px_40px_rgba(255,77,139,0.12)] md:-mt-4 md:mb-4"
              : "border-transparent shadow-[0_2px_16px_rgba(0,0,0,0.04)] hover:shadow-[0_8px_32px_rgba(0,0,0,0.08)] hover:border-hairline"
          }`}
          data-reveal-delay={String(i * 100)}
        >
          {plan.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-pink text-white text-xs font-bold tracking-wide uppercase px-4 py-1.5 rounded-full">
              {plan.badge}
            </div>
          )}

          <h3 class="text-xl font-bold text-ink mb-1">{plan.name}</h3>
          <p class="text-sm text-muted mb-6">{plan.description}</p>

          <!-- Price -->
          <div class="mb-2">
            <div class="flex items-baseline gap-1">
              <span class="text-5xl md:text-6xl font-bold text-ink tracking-tight">฿{plan.price}</span>
              <span class="text-lg text-muted">{plan.period}</span>
            </div>
            <p class="text-sm text-muted-soft mt-1">
              {plan.priceMonthly !== "0" ? `ประมาณ ฿${plan.priceMonthly}/เดือน` : "ใช้งานฟรีไม่จำกัดเวลา"}
            </p>
          </div>

          <!-- Customer limit -->
          <div class="py-4 mb-6 border-t border-b border-hairline">
            <div class="flex items-center gap-2 text-body font-medium">
              <i class="fa-solid fa-users text-brand-pink text-sm"></i>
              <span>{plan.customerLimit}</span>
            </div>
          </div>

          <!-- Features -->
          <ul class="space-y-3 flex-1 mb-8">
            {COMMON_FEATURES.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-body">
                <i class="fa-solid fa-check text-brand-pink text-xs mt-0.5 shrink-0" />
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a
            href={APP_SIGNUP}
            class={`py-3.5 px-6 rounded-xl font-semibold text-center no-underline transition active:scale-95 ${
              plan.highlighted
                ? "bg-brand-pink text-white hover:bg-brand-pink/90"
                : "bg-ink text-white hover:bg-ink/80"
            }`}
          >
            สมัครใช้งานฟรี
          </a>
          <p class="mt-3 text-xs text-muted text-center leading-relaxed">
            เรามีข้อผูกพันชัดเจนว่าจะไม่ขาย ไม่แบ่งปัน และไม่ใช้ข้อมูลลูกค้าเพื่อประโยชน์ทางการค้า
            โดยเด็ดขาด
          </p>
        </div>
      ))
    }
  </div>

  <!-- Enterprise CTA -->
  <div class="text-center mt-12 reveal">
    <p class="text-muted">
      จัดการลูกค้ามากกว่า 3,000 ราย?{" "}
      <a href="#" class="text-brand-pink font-semibold no-underline hover:underline">
        ติดต่อทีมงานของเรา
      </a>
    </p>
  </div>
</section>

<!-- ===== SHOWCASE ===== -->
<section id="showcase" class="bg-surface-strong py-28 px-6 scroll-mt-20">
  <div class="max-w-5xl mx-auto text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-semibold tracking-tight mb-6">
      Solid Plan บน iPad
