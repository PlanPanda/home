---
const lineUrl = "https://line.me/R/ti/p/@675lurmh";
const signupUrl = "https://app.solidplan.ai/signup";
import BeforeAfter from './BeforeAfter.astro';
import Testimonials from './Testimonials.astro';
import Line from './icons/Line.astro';
import AsciiWave from './AsciiWave.astro';
import HomeDemo from './home-demo/HomeDemo';
---
      <section class="ref-hero" id="ref-top">
        <AsciiWave />
        <div class="shell ref-hero-copy">
          <h1>จำลูกค้าได้ทุกคน<br />โดยที่คุณไม่ต้องจดเอง</h1>
          <p class="ref-hero-sub">ตอนนี้ข้อมูลลูกค้ากระจายอยู่ในโน้ต Line และไฟล์ ทำให้ทุกครั้งที่อยากให้ AI ช่วย คุณต้องไล่หาข้อมูลมาป้อนเอง และยิ่งป้อนมาก AI ก็ยิ่งสับสน Solid Plan เก็บข้อมูลลูกค้าไว้ในระบบประกันของคุณ AI ดึงเฉพาะส่วนที่เกี่ยวกับคำถามมาตอบ และบันทึกให้เมื่อแค่คุณสั่ง</p>
          <div class="ref-cta-row">
            <a class="ref-pill" href={signupUrl}>สมัครสมาชิก</a>
            <a class="ref-pill ghost" href={lineUrl}><Line size={18} /> เพิ่มเพื่อนใน LINE</a>
          </div>
          <small>สมัครใช้งานได้ทันที หรือทักมาคุยกับเราก่อนดูการทำงานจริงก็ได้</small>
        </div>

        <div class="ref-stage" id="ref-demo">
          <HomeDemo client:load />
          <noscript><p>ดูตัวอย่างเพิ่มเติมที่ <a href="/features">หน้าฟีเจอร์</a></p></noscript>
        </div>
      </section>

      <BeforeAfter />
      <Testimonials />
      <section class="ref-before-after" hidden aria-hidden="true">
        <div class="shell">
          <header><h2>ใช้ AI กับงานประกัน<br />ทำไมยังไม่ลื่น</h2><p>เพราะข้อมูลลูกค้ายังกระจายอยู่หลายที่ คุณจึงต้องเป็นทั้งคนจด คนค้น และคนป้อนข้อมูลเอง</p></header>
          <article class="ref-pair">
            <span class="ref-pair-tag">01 · จดเอง</span>
            <h3>ได้กรมธรรม์มาแล้ว ต้องนั่งพิมพ์ลงฟอร์มเองทีละช่อง</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <img class="before-photo" src="/images/before-transcription.jpg" alt="กรมธรรม์และคอมพิวเตอร์สำหรับกรอกข้อมูลทีละช่อง" width="1200" height="900" loading="lazy" /><small>เปิดกรมธรรม์แล้วพิมพ์ลงฟอร์มทีละช่อง</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <div class="ref-handoff" aria-hidden="true">
                  <span class="ref-filechip"><svg viewBox="0 0 24 24"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path></svg>policy-sample.pdf</span>
                  <div class="ref-answer">
                    <strong>ข้อมูลที่ AI อ่านได้ 5 ช่อง</strong>
                    <span>แบบประกัน · ทุน · เบี้ย · เลขกรมธรรม์ · วันเริ่มสัญญา</span>
                    <span>เหลือแค่ตรวจ แล้วกดบันทึก</span>
                  </div>
                </div>
                <small>โยน PDF เข้ามา AI อ่านและจดให้ แค่ตรวจแล้วกดบันทึก</small>
              </section>
            </div>
          </article>

          <article class="ref-pair">
            <span class="ref-pair-tag">02 · ค้นเอง</span>
            <h3>อยากรู้ข้อมูลลูกค้า ต้องไล่หาจากหลายที่</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <img class="before-photo" src="/images/before-search.jpg" alt="หน้าจอ Windows ที่ข้อมูลลูกค้ากระจายอยู่ใน LINE, Excel และ Notes ด้วยข้อมูลสมมติ" width="1200" height="900" loading="lazy" /><small>ข้อมูลลูกค้าแยกอยู่ใน LINE, Excel และ Notes</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <p class="ref-question">คุณกานต์มีกรมธรรม์อะไรบ้าง?</p>
                <div class="ref-answer"><strong>พบ 2 กรมธรรม์</strong><span>ตลอดชีพ · เบี้ย 24,000 บาท/ปี</span><span>สุขภาพ · เบี้ย 18,500 บาท/ปี</span></div>
                <small>ถามแล้วได้คำตอบจากข้อมูลจริงในระบบ</small>
              </section>
            </div>
          </article>

          <article class="ref-pair">
            <span class="ref-pair-tag">03 · ป้อนข้อมูลให้ AI</span>
            <h3>อยากให้ AI ช่วย ต้องก๊อปข้อมูลไปวางทุกครั้ง</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <img class="before-photo" src="/images/before-ai-input.jpg" alt="หน้าจอ Mac ที่กำลังลากไฟล์ Excel และ TXT จำนวนมากเข้าแชต AI ด้วยข้อมูลสมมติ" width="1200" height="900" loading="lazy" /><small>ลากไฟล์ Excel และ TXT หลายไฟล์เข้า AI ทุกครั้งที่ต้องการให้ช่วย</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <p class="ref-question">เดือนนี้ใครเกิดบ้าง และสัปดาห์นี้ควรติดต่อใคร?</p>
                <div class="ref-answer"><strong>ค้นและนับจากลูกค้า 312 รายในระบบ</strong><span>วันเกิดเดือนนี้ 5 ราย</span><span>ควรติดต่อสัปดาห์นี้ 3 ราย · เหตุผลและประวัติดูได้ครบ</span></div>
                <small>AI รู้จักลูกค้าของคุณอยู่แล้ว ไม่ต้องป้อนซ้ำ</small>
              </section>
            </div>
          </article>
        </div>
      </section>

      <section class="ref-trust" id="ref-trust">
        <div class="shell">
          <header class="ref-trust-head">
            <h2>เราดูแลข้อมูล<br />ให้คุณดูแลลูกค้า</h2>
            <p>Solid Plan ถูกสร้างขึ้นบนแนวคิดที่ว่า “ความสัมพันธ์ระหว่างคุณกับลูกค้า คือสิ่งสำคัญที่สุด” เราจึงออกแบบให้คุณควบคุมการเข้าถึง การใช้ AI และการนำข้อมูลออกไปใช้ต่อได้ เพื่อให้คุณดูแลลูกค้าอย่างมั่นใจในทุกขั้นตอน</p>
          </header>
          <div class="ref-trust-grid">
            <article>
              <span class="ref-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 4.8 3.4 7.8 8 9 4.6-1.2 8-4.2 8-9V7z"></path><path d="m9 12 2 2 4-4"></path></svg></span>
              <h3>ส่งให้ AI เฉพาะที่จำเป็น</h3>
              <p>เมื่อคุณสั่งให้ AI ช่วย ระบบเลือกเฉพาะข้อมูลที่เกี่ยวข้องกับคำถามเพื่อส่งผ่าน OpenRouter และผู้ให้บริการโมเดล ไม่ส่งฐานข้อมูลลูกค้าทั้งหมดไปพร้อมกัน</p>
            </article>
            <article>
              <span class="ref-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"></circle><path d="m11 12 8-8m-3 3 2 2m-5 1 2 2"></path></svg></span>
              <h3>คุณกำหนดว่าใครเข้าถึงได้</h3>
              <p>ข้อมูลเปิดได้จากบัญชีของคุณและคนที่คุณอนุญาต คุณยังส่งออกข้อมูลเพื่อนำไปใช้ต่อกับระบบอื่นได้ โดยไม่ถูกผูกไว้กับ Solid Plan</p>
            </article>
            <article>
              <span class="ref-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 7h8M8 11h8M8 15h4"></path></svg></span>
              <h3>โครงสร้างพื้นฐานที่ผ่านการตรวจสอบ</h3>
              <p>Solid Plan โฮสต์บน Railway ซึ่งได้รับการรับรอง SOC 2 Type II และ SOC 3 โดยการรับรองนี้เป็นของ Railway ในฐานะผู้ให้บริการโครงสร้างพื้นฐาน</p>
              <div class="ref-compliance-mark"><img src="/images/aicpa.svg" alt="AICPA" width="40" height="40" /><span><strong>SOC 2 Type II · SOC 3</strong><small>Railway infrastructure</small></span></div>
            </article>
          </div>
          <a class="ref-trust-link" href="/security-privacy">ดูมาตรฐานความปลอดภัยและความเป็นส่วนตัว <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="ref-final" id="ref-contact"><div class="shell"><h2>จำลูกค้าได้ทุกคน<br />โดยที่คุณไม่ต้องจดเอง</h2><div class="ref-cta-row center"><a class="ref-pill" href={signupUrl}>สมัครสมาชิก</a><a class="ref-pill ghost" href={lineUrl}><Line size={18} /> เพิ่มเพื่อนใน LINE</a></div><p>เริ่มต้นจัดการลูกค้าทุกคนไว้ในที่เดียว</p></div></section>


<style is:global>
  .ref-hero { position:relative; padding-top:74px; text-align:center; overflow:hidden; }
  .ref-hero > :not(.ascii-wave) { position:relative; z-index:1; }
  .ref-hero-copy h1 { margin:0; font-size:64px; line-height:1.45; letter-spacing:0; text-wrap:balance; }
  .ref-hero-sub { max-width:780px; margin:24px auto 26px; color:#6e6e73; font-size:16px; line-height:1.75; }
  .ref-cta-row { display:flex; flex-wrap:wrap; gap:10px 14px; justify-content:center; align-items:center; margin-top:6px; }
  .ref-cta-row.center { margin:34px 0 0; }
  .ref-hero-copy small { display:block; margin-top:15px; color:#6e6e73; }

  /* Hero demo (src/components/home-demo) */
  .ref-stage { width:min(960px, calc(100% - 24px)); margin:52px auto 0; text-align:left; transition:opacity .3s ease; }
  /* The server renders the wide layout; hide it until the island picks its own */
  .ref-stage:has(astro-island[ssr]) { opacity:0; }

  .demo-toolbar { display:grid; grid-template-columns:44px auto 20px; justify-content:center; align-items:center; gap:12px; padding:24px 20px 86px; }
  .demo-toggle { width:44px; height:44px; display:grid; place-items:center; padding:0; border:1px solid var(--ref-hair); border-radius:50%; background:#fff; color:#1d1d1f; }
  .demo-toggle:hover { background:var(--ref-soft); }
  .demo-icon { grid-area:1/1; width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .demo-toggle .play { display:none; fill:currentColor; stroke:none; }
  .demo-toggle[aria-pressed="false"] .pause { display:none; }
  .demo-toggle[aria-pressed="false"] .play { display:block; }
  .ref-scenarios { display:flex; justify-content:center; gap:10px; min-width:0; }
  .ref-scenarios button { display:inline-flex; align-items:center; gap:8px; min-height:44px; padding:0 18px; border:1px solid var(--ref-hair); border-radius:999px; background:#fff; color:#1d1d1f; transition:background .3s, color .3s, border-color .3s, transform .3s; }
  .ref-scenarios button>span { position:relative; z-index:1; }
  .ref-scenarios button:hover { background:var(--ref-soft); }
  .ref-scenarios button[aria-pressed="true"] { background:#1d1d1f; color:#fff; border-color:#1d1d1f; }
  @property --scenario-progress { syntax:"<angle>"; inherits:false; initial-value:0deg; }
  .demo-countdown { --scenario-progress:0deg; width:18px; height:18px; padding:2px; border-radius:50%; background:conic-gradient(#1d1d1f var(--scenario-progress), #d2d2d7 0); }
  .demo-countdown i { display:block; width:100%; height:100%; border-radius:50%; background:#fff; }
  .demo-countdown.is-running { animation:scenario-countdown var(--scenario-duration, 4s) linear forwards; }

  .ref-before-after { padding:110px 0; background:var(--ref-soft); }
  .ref-before-after header { max-width:710px; }
  .ref-before-after h2 { margin:0; font-size:48px; line-height:1.45; letter-spacing:0; text-wrap:balance; }
  .ref-before-after header p { margin-top:18px; color:#6e6e73; font-size:18px; }
  .ref-pair { margin-top:82px; }
  .ref-pair h3 { max-width:720px; margin:0 0 24px; font-size:32px; line-height:1.5; }
  .ref-pair>div { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .ref-before,.ref-after { min-height:330px; padding:28px; border-radius:24px; display:flex; flex-direction:column; }
  .ref-before { border:1.5px dashed var(--ref-hair); background:#fff; }
  .ref-after { background:#000; color:#fff; box-shadow:0 30px 60px -40px rgba(0,0,0,.6); }
  .ref-before>b { color:#b72963; }
  .ref-after>b { color:#fff; }
  .ref-before small,.ref-after small { margin-top:auto; color:#6e6e73; }
  .ref-after small { color:#a1a1a6; }
  .ref-notes { display:flex; flex-wrap:wrap; gap:12px; align-items:flex-start; margin:32px 0; }
  .ref-notes span { width:158px; padding:10px 12px; background:#f2dc8a; color:#4a3f12; font-size:13px; box-shadow:0 2px 0 rgba(0,0,0,.12); transform:rotate(-2.5deg); }
  .ref-notes span:nth-child(2) { transform:rotate(2deg) translateY(8px); }
  .ref-question { align-self:flex-end; margin:32px 0 16px; padding:10px 15px; border-radius:18px 18px 6px 18px; background:#1c1c1e; border:1px solid #2c2c2e; }
  .ref-answer { display:flex; flex-direction:column; gap:7px; padding:16px; border-radius:14px; background:#1c1c1e; border:1px solid #2c2c2e; }
  .ref-answer strong { color:#fff; }
  .ref-answer span { color:#d1d1d6; }
  .ref-pair-tag { display:inline-flex; align-items:center; margin-bottom:14px; padding:5px 12px; border:1px solid var(--ref-hair); border-radius:999px; color:#6e6e73; font-size:12.5px; font-weight:600; letter-spacing:0; }
  .ref-docform { display:grid; grid-template-columns:.72fr 1.28fr; gap:14px; align-items:start; margin:32px 0; }
  .ref-paper { display:flex; flex-direction:column; gap:8px; aspect-ratio:.8; padding:16px; border:1px solid var(--ref-hair); border-radius:10px; background:#fff; box-shadow:6px 6px 0 #e7e7e3; }
  .ref-paper span { align-self:flex-start; padding:2px 7px; border-radius:5px; background:#1d1d1f; color:#fff; font-size:10px; }
  .ref-paper i { height:6px; border-radius:3px; background:#e8e8ec; }
  .ref-paper i:nth-child(4) { width:78%; background:#f3ddb0; }
  .ref-paper i:nth-child(5) { width:64%; background:#f3ddb0; }
  .ref-paper i:nth-child(7) { width:52%; }
  .ref-form { padding:16px; border:1px solid var(--ref-hair); border-radius:14px; background:#fff; }
  .ref-form-h { margin-bottom:8px; padding-bottom:9px; border-bottom:1px solid var(--ref-edge); font-size:13px; font-weight:600; }
  .ref-field { display:grid; grid-template-columns:96px 1fr; gap:10px; align-items:center; padding:7px 0; font-size:12.5px; }
  .ref-field+.ref-field { border-top:1px dashed #eeeef2; }
  .ref-field span { color:#6e6e73; }
  .ref-field b { font-weight:600; }
  .ref-field em { color:#b72963; font-style:normal; font-size:11.5px; }
  .ref-caret { display:inline-block; width:1.5px; height:14px; background:#111; animation:sp-caret 1.1s steps(1) infinite; }
  .ref-handoff { display:flex; flex-direction:column; align-items:flex-start; gap:12px; margin:32px 0; }
  .ref-filechip { display:inline-flex; align-items:center; gap:7px; padding:6px 12px; border:1px solid #3a3a3c; border-radius:9px; background:#1c1c1e; color:#d1d1d6; font-size:12px; }
  .ref-filechip svg { width:13px; height:13px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .ref-linesheet { display:flex; flex-direction:column; align-items:flex-start; gap:12px; margin:0 0 26px; }
  .ref-bub { align-self:flex-end; padding:7px 12px; border-radius:14px 14px 4px 14px; background:#ddf3d6; color:#1f3a1a; font-size:12.5px; }
  .ref-sheet { display:grid; grid-template-columns:repeat(3,1fr); width:100%; max-width:320px; border:1px solid var(--ref-hair); font-size:11.5px; }
  .ref-sheet span { padding:4px 8px; border:1px solid var(--ref-edge); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .ref-sheet .hd { background:var(--ref-soft); font-weight:600; }
  .ref-table { margin:32px 0 18px; border:1px solid var(--ref-hair); border-radius:12px; overflow:hidden; background:#fff; font-size:12px; }
  .ref-copy-files { display:flex; flex-wrap:wrap; gap:6px; margin:26px 0 -18px; }
  .ref-copy-files span { padding:5px 8px; border:1px solid var(--ref-hair); border-radius:6px; background:#fff; color:#6e6e73; font-size:10.5px; }
  .rt-h,.rt-r { display:grid; grid-template-columns:1.15fr 1fr 1fr .85fr; gap:8px; padding:7px 12px; }
  .rt-h { background:var(--ref-soft); font-weight:600; color:#3a3a3c; }
  .rt-r { border-top:1px solid #f0f0f4; color:#3a3a3c; }
  .rt-r span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rt-more { padding:8px 12px; border-top:1px dashed var(--ref-hair); background:#fafafa; color:#6e6e73; font-size:11.5px; }
  .ref-qchips { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:26px; }
  .ref-qchips span { padding:6px 12px; border:1px dashed var(--ref-hair); border-radius:999px; background:#fff; color:#6e6e73; font-size:12px; }
  .ref-trust { padding:110px 0; background:#111; color:#fff; scroll-margin-top:72px; }
  .ref-trust-head { max-width:980px; }
  .ref-trust h2 { margin:0; font-size:48px; line-height:1.45; letter-spacing:0; text-wrap:balance; }
  .ref-trust-head>p { max-width:860px; margin:24px 0 0; color:#c7c7cc; font-size:18px; line-height:1.75; }
  .ref-trust-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:0; margin-top:58px; border-block:1px solid #303033; }
  .ref-trust-grid article { min-width:0; padding:32px 30px 34px; }
  .ref-trust-grid article+article { border-left:1px solid #303033; }
  .ref-trust-icon { display:grid; place-items:center; width:42px; height:42px; border:1px solid #3a3a3c; border-radius:8px; color:#fff; }
  .ref-trust-icon svg { width:21px; height:21px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .ref-trust-grid h3 { margin:24px 0 12px; font-size:21px; line-height:1.4; }
  .ref-trust-grid p { margin:0; color:#b9b9bf; font-size:15px; line-height:1.75; }
  .ref-compliance-mark { display:flex; align-items:center; gap:10px; margin-top:24px; width:max-content; max-width:100%; padding:8px 12px 8px 9px; border-radius:8px; background:#fff; color:#111; }
  .ref-compliance-mark img { flex:none; }
  .ref-compliance-mark strong,.ref-compliance-mark small { display:block; }
  .ref-compliance-mark strong { font-size:12px; line-height:1.35; }
  .ref-compliance-mark small { margin-top:2px; color:#525258; font-size:10px; line-height:1.3; }
