---
const lineUrl = "https://line.me/R/ti/p/@675lurmh";
const signupUrl = "https://app.solidplan.ai/signup";
import BeforeAfter from './BeforeAfter.astro';
import Testimonials from './Testimonials.astro';
import Line from './icons/Line.astro';
---
      <section class="ref-hero" id="ref-top">
        <div class="shell ref-hero-copy">
          <h1>จำลูกค้าได้ทุกคน<br />โดยที่คุณไม่ต้องจดเอง</h1>
          <p class="ref-hero-sub">ตอนนี้ข้อมูลลูกค้ากระจายอยู่ในโน้ต Line และไฟล์ ทำให้ทุกครั้งที่อยากให้ AI ช่วย คุณต้องไล่หาข้อมูลมาป้อนเอง และยิ่งป้อนมาก AI ก็ยิ่งสับสน Solid Plan เก็บข้อมูลลูกค้าไว้ในระบบประกันของคุณ AI ดึงเฉพาะส่วนที่เกี่ยวกับคำถามมาตอบ และบันทึกให้เมื่อแค่คุณสั่ง</p>
          <div class="ref-cta-row">
            <a class="ref-pill" href={signupUrl}>สมัครสมาชิก</a>
            <a class="ref-pill ghost" href={lineUrl}><Line size={18} /> เพิ่มเพื่อนใน LINE</a>
          </div>
          <small>สมัครใช้งานได้ทันที หรือทักมาคุยกับเราก่อนดูการทำงานจริงก็ได้</small>
        </div>

        <div class="ref-stage" id="ref-demo">
          <div class="ipad" aria-label="ตัวอย่างแอป Solid Plan บน iPad">
            <span class="ipad-cam" aria-hidden="true"></span>
            <div class="ipad-screen">
              <div class="app">
                <aside class="app-rail" aria-label="เมนูในแอป (ตัวอย่าง)">
                  <img class="rail-logo" src="/brand/logo-192.png" alt="" width="26" height="26" />
                  <div class="rail-menu">
                    <span class="rail-item on"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>ผู้ช่วย AI</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>ลูกค้า</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>ปฏิทิน</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 20a6 6 0 0 0-12 0"></path><circle cx="12" cy="10" r="4"></circle><circle cx="12" cy="12" r="10"></circle></svg>ทีมงาน</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>ยอดขาย</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 17V9"></path><path d="M12 17V5"></path><path d="M6 17v-3"></path></svg>รายงาน</span>
                    <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>ตั้งค่า</span>
                  </div>
                  <span class="rail-me" aria-hidden="true">ก</span>
                </aside>
                <div class="app-main">
                  <header class="app-head">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg>
                    <b>ผู้ช่วย AI</b>
                    <svg class="head-plus" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                  </header>
                  <div class="app-body" data-app-body>
                    <div class="app-thread" data-thread role="log" aria-live="polite" aria-label="ตัวอย่างบทสนทนาและข้อมูลที่รอยืนยัน ซึ่งเล่นอัตโนมัติ"></div>
                    <div class="app-dock" data-dock>
                      <div class="welcome-wrap">
                        <div class="app-welcome">
                          <svg class="sp-avatar welcome-avatar" viewBox="0 0 160 160" aria-hidden="true"><g class="character"><rect class="body" x="28" y="28" width="104" height="104" rx="28"></rect><g class="face"><g class="normal"><rect class="eye" x="59" y="65" width="9" height="22" rx="4.5"></rect><rect class="eye" x="92" y="65" width="9" height="22" rx="4.5"></rect></g><g class="happy"><path d="M56 81 Q64 65 72 81 M88 81 Q96 65 104 81"></path></g></g></g><g class="dots"><circle cx="48" cy="80" r="8"></circle><circle cx="80" cy="80" r="8"></circle><circle cx="112" cy="80" r="8"></circle></g></svg>
                          <b>มีอะไรให้ช่วยไหม?</b>
                          <span>ถามข้อมูลลูกค้า งานกรมธรรม์ หรือให้ช่วยบันทึกได้เลย</span>
                        </div>
                      </div>
                      <div class="app-composer" aria-hidden="true">
                        <div class="composer-row">
                          <span class="composer-add"><svg viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span>
                          <span class="composer-file" data-composer-file hidden></span>
                          <span class="composer-ph" data-composer-text>ถามผู้ช่วย AI…</span>
                          <span class="composer-send"><svg viewBox="0 0 24 24"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg></span>
                        </div>
                      </div>
                      <div class="chips-wrap">
                        <div class="composer-chips">
                          <button type="button" data-chip="upload">เพิ่มกรมธรรม์จากไฟล์แนบ</button>
                          <button type="button" data-chip="summary">สรุปข้อมูลลูกค้าก่อนเข้าพบ</button>
                          <button type="button" data-chip="follow">ลูกค้าที่ยังไม่ได้ติดตามมีใครบ้าง</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <noscript><p>ดูตัวอย่างเพิ่มเติมที่ <a href="/features">หน้าฟีเจอร์</a></p></noscript>
          <div class="demo-toolbar">
            <button class="demo-toggle" type="button" data-demo-toggle aria-pressed="true" aria-label="หยุดเล่นอัตโนมัติ" title="หยุดเล่นอัตโนมัติ">
              <svg class="demo-icon pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5v14M15 5v14"></path></svg>
              <svg class="demo-icon play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7z"></path></svg>
            </button>
            <div class="ref-scenarios" aria-label="เลือกตัวอย่างการใช้งาน">
              <button type="button" aria-pressed="true" data-ref-scenario="upload"><span>อัปโหลดกรมธรรม์</span></button>
              <button type="button" aria-pressed="false" data-ref-scenario="summary"><span>สรุปลูกค้า</span></button>
              <button type="button" aria-pressed="false" data-ref-scenario="add"><span>เพิ่มลูกค้า</span></button>
              <button type="button" aria-pressed="false" data-ref-scenario="follow"><span>ใครควรติดตาม</span></button>
            </div>
            <span class="demo-countdown" data-demo-timer aria-hidden="true"><i></i></span>
          </div>
        </div>
      </section>

      <BeforeAfter />
      <Testimonials />
      <section class="ref-before-after" hidden aria-hidden="true">
        <div class="shell">
          <header><h2>ใช้ AI กับงานประกัน<br />ทำไมยังไม่ลื่น</h2><p>เพราะข้อมูลลูกค้ายังกระจายอยู่หลายที่ คุณจึงต้องเป็นทั้งคนจด คนค้น และคนป้อนข้อมูลเอง</p></header>
          <article class="ref-pair">
            <span class="ref-pair-tag">01 · จดเอง</span>
            <h3>ได้กรมธรรม์มาแล้ว ต้องนั่งพิมพ์ลงฟอร์มเองทีละช่อง</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <img class="before-photo" src="/images/before-transcription.jpg" alt="กรมธรรม์และคอมพิวเตอร์สำหรับกรอกข้อมูลทีละช่อง" width="1200" height="900" loading="lazy" /><small>เปิดกรมธรรม์แล้วพิมพ์ลงฟอร์มทีละช่อง</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <div class="ref-handoff" aria-hidden="true">
                  <span class="ref-filechip"><svg viewBox="0 0 24 24"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path></svg>policy-sample.pdf</span>
                  <div class="ref-answer">
                    <strong>ข้อมูลที่ AI อ่านได้ 5 ช่อง</strong>
                    <span>แบบประกัน · ทุน · เบี้ย · เลขกรมธรรม์ · วันเริ่มสัญญา</span>
                    <span>เหลือแค่ตรวจ แล้วกดบันทึก</span>
                  </div>
                </div>
                <small>โยน PDF เข้ามา AI อ่านและจดให้ แค่ตรวจแล้วกดบันทึก</small>
              </section>
            </div>
          </article>

          <article class="ref-pair">
            <span class="ref-pair-tag">02 · ค้นเอง</span>
            <h3>อยากรู้ข้อมูลลูกค้า ต้องไล่หาจากหลายที่</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <img class="before-photo" src="/images/before-search.jpg" alt="หน้าจอ Windows ที่ข้อมูลลูกค้ากระจายอยู่ใน LINE, Excel และ Notes ด้วยข้อมูลสมมติ" width="1200" height="900" loading="lazy" /><small>ข้อมูลลูกค้าแยกอยู่ใน LINE, Excel และ Notes</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <p class="ref-question">คุณกานต์มีกรมธรรม์อะไรบ้าง?</p>
                <div class="ref-answer"><strong>พบ 2 กรมธรรม์</strong><span>ตลอดชีพ · เบี้ย 24,000 บาท/ปี</span><span>สุขภาพ · เบี้ย 18,500 บาท/ปี</span></div>
                <small>ถามแล้วได้คำตอบจากข้อมูลจริงในระบบ</small>
              </section>
            </div>
          </article>

          <article class="ref-pair">
            <span class="ref-pair-tag">03 · ป้อนข้อมูลให้ AI</span>
            <h3>อยากให้ AI ช่วย ต้องก๊อปข้อมูลไปวางทุกครั้ง</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <img class="before-photo" src="/images/before-ai-input.jpg" alt="หน้าจอ Mac ที่กำลังลากไฟล์ Excel และ TXT จำนวนมากเข้าแชต AI ด้วยข้อมูลสมมติ" width="1200" height="900" loading="lazy" /><small>ลากไฟล์ Excel และ TXT หลายไฟล์เข้า AI ทุกครั้งที่ต้องการให้ช่วย</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <p class="ref-question">เดือนนี้ใครเกิดบ้าง และสัปดาห์นี้ควรติดต่อใคร?</p>
                <div class="ref-answer"><strong>ค้นและนับจากลูกค้า 312 รายในระบบ</strong><span>วันเกิดเดือนนี้ 5 ราย</span><span>ควรติดต่อสัปดาห์นี้ 3 ราย · เหตุผลและประวัติดูได้ครบ</span></div>
                <small>AI รู้จักลูกค้าของคุณอยู่แล้ว ไม่ต้องป้อนซ้ำ</small>
              </section>
            </div>
          </article>
        </div>
      </section>

      <section class="ref-trust" id="ref-trust">
        <div class="shell">
          <header class="ref-trust-head">
            <h2>เราดูแลข้อมูล<br />ให้คุณดูแลลูกค้า</h2>
            <p>Solid Plan ถูกสร้างขึ้นบนแนวคิดที่ว่า “ความสัมพันธ์ระหว่างคุณกับลูกค้า คือสิ่งสำคัญที่สุด” เราจึงออกแบบให้คุณควบคุมการเข้าถึง การใช้ AI และการนำข้อมูลออกไปใช้ต่อได้ เพื่อให้คุณดูแลลูกค้าอย่างมั่นใจในทุกขั้นตอน</p>
          </header>
          <div class="ref-trust-grid">
            <article>
              <span class="ref-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 4.8 3.4 7.8 8 9 4.6-1.2 8-4.2 8-9V7z"></path><path d="m9 12 2 2 4-4"></path></svg></span>
              <h3>ส่งให้ AI เฉพาะที่จำเป็น</h3>
              <p>เมื่อคุณสั่งให้ AI ช่วย ระบบเลือกเฉพาะข้อมูลที่เกี่ยวข้องกับคำถามเพื่อส่งผ่าน OpenRouter และผู้ให้บริการโมเดล ไม่ส่งฐานข้อมูลลูกค้าทั้งหมดไปพร้อมกัน</p>
            </article>
            <article>
              <span class="ref-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"></circle><path d="m11 12 8-8m-3 3 2 2m-5 1 2 2"></path></svg></span>
              <h3>คุณกำหนดว่าใครเข้าถึงได้</h3>
              <p>ข้อมูลเปิดได้จากบัญชีของคุณและคนที่คุณอนุญาต คุณยังส่งออกข้อมูลเพื่อนำไปใช้ต่อกับระบบอื่นได้ โดยไม่ถูกผูกไว้กับ Solid Plan</p>
            </article>
            <article>
              <span class="ref-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 7h8M8 11h8M8 15h4"></path></svg></span>
              <h3>โครงสร้างพื้นฐานที่ผ่านการตรวจสอบ</h3>
              <p>Solid Plan โฮสต์บน Railway ซึ่งได้รับการรับรอง SOC 2 Type II และ SOC 3 โดยการรับรองนี้เป็นของ Railway ในฐานะผู้ให้บริการโครงสร้างพื้นฐาน</p>
              <div class="ref-compliance-mark"><img src="/images/aicpa.svg" alt="AICPA" width="40" height="40" /><span><strong>SOC 2 Type II · SOC 3</strong><small>Railway infrastructure</small></span></div>
            </article>
          </div>
          <a class="ref-trust-link" href="/security-privacy">ดูมาตรฐานความปลอดภัยและความเป็นส่วนตัว <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="ref-final" id="ref-contact"><div class="shell"><h2>จำลูกค้าได้ทุกคน<br />โดยที่คุณไม่ต้องจดเอง</h2><div class="ref-cta-row center"><a class="ref-pill" href={signupUrl}>สมัครสมาชิก</a><a class="ref-pill ghost" href={lineUrl}><Line size={18} /> เพิ่มเพื่อนใน LINE</a></div><p>เริ่มต้นจัดการลูกค้าทุกคนไว้ในที่เดียว</p></div></section>

    <script>
      /* Variant C — animated chat demo (scripted, fictional data only) */
      const cThread = document.querySelector("[data-thread]");
      if (cThread) {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let runId = 0;
        let cycleTimer = 0;
        let autoplay = !reduce;
        let activeKey = "upload";
        let demoObserver;
        const scenarioKeys = ["upload", "summary", "add", "follow"];

        const ICONS = {
          file: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>',
          check: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>',
          chev: '<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>',
        };
        const AVATAR = '<svg class="sp-avatar" viewBox="0 0 160 160" aria-hidden="true"><g class="character"><rect class="body" x="28" y="28" width="104" height="104" rx="28"></rect><g class="face"><g class="normal"><rect class="eye" x="59" y="65" width="9" height="22" rx="4.5"></rect><rect class="eye" x="92" y="65" width="9" height="22" rx="4.5"></rect></g><g class="happy"><path d="M56 81 Q64 65 72 81 M88 81 Q96 65 104 81"></path></g></g></g><g class="dots"><circle cx="48" cy="80" r="8"></circle><circle cx="80" cy="80" r="8"></circle><circle cx="112" cy="80" r="8"></circle></g></svg>';

        const confirmCard = (title, who, secs, note) =>
          `<div class="card-confirm rv"><div class="cc-head"><div><small>รอยืนยัน</small><strong>${title}</strong><p>${who}</p></div><span class="cc-badge" aria-hidden="true">✓</span></div>` +
          secs.map(([label, rows]) => `<div class="cc-sec"><b>${label}</b><div class="cc-rows">${rows.map(([k, v]) => `<p class="cc-row"><span>${k}</span><b>${v}</b></p>`).join("")}</div></div>`).join("") +
          (note ? `<p class="cc-note">${note}</p>` : "") +
          `<div class="cc-actions"><button type="button" class="primary" data-confirm-action>ยืนยันสร้าง</button><button type="button" class="cancel" data-cancel-action>ยกเลิก</button></div><p class="cc-status" data-card-status hidden></p></div>`;

        const SCENARIOS = {
          upload: {
            user: "เพิ่มกรมธรรม์ให้คุณกานต์ พูนสุข จากไฟล์แนบ",
            file: "policy-sample.pdf",
