<canvas class="ascii-wave" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".ascii-wave");
  const host = canvas?.parentElement;
  const ctx = canvas?.getContext("2d");
  if (canvas && host && ctx) {
    const CHARS = " .·:-=+*#%@";
    const CW = 11, CH = 16; // cell size in CSS px
    const LIFE = 2200; // ms a ripple lives
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const trail: { x: number; y: number; t: number; s: number }[] = [];
    let cols = 0, rows = 0, raf = 0, visible = true, last = { x: 0, y: 0, t: 0 };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const { width, height } = host.getBoundingClientRect();
      canvas.width = width * dpr; canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = `13px ui-monospace, Menlo, monospace`;
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      cols = Math.ceil(width / CW); rows = Math.ceil(height / CH);
    };

    const draw = (now: number) => {
      while (trail.length && now - trail[0].t > LIFE) trail.shift();
      ctx.clearRect(0, 0, cols * CW, rows * CH);
      for (let r = 0; r < rows; r++) {
        const y = r * CH + CH / 2;
        for (let c = 0; c < cols; c++) {
          const x = c * CW + CW / 2;
          let v = 0;
          for (const p of trail) {
            const age = (now - p.t) / LIFE;
            const d = Math.hypot(x - p.x, y - p.y);
            const front = age * 360; // ripple radius grows outward
            if (Math.abs(d - front) > 90) continue;
            v += p.s * (1 - age) * Math.cos((d - front) * 0.07) * Math.exp(-((d - front) ** 2) / 2600);
          }
          const a = Math.min(1, Math.abs(v));
          const i = Math.round(a * (CHARS.length - 1));
          if (!i) continue;
          ctx.fillStyle = `rgba(29,29,31,${0.03 + a * 0.2})`;
          ctx.fillText(CHARS[i], x, y);
        }
      }
    };

    // stop once the last ripple fades; pointermove restarts it
    const loop = (now: number) => { draw(now); raf = visible && trail.length ? requestAnimationFrame(loop) : 0; };
    const start = () => { if (!raf && !reduce) raf = requestAnimationFrame(loop); };

    host.addEventListener("pointermove", (e) => {
      const b = canvas.getBoundingClientRect();
      const x = e.clientX - b.left, y = e.clientY - b.top, t = performance.now();
      if (t - last.t < 40) return; // throttle: ~25 ripples/s max
      const speed = Math.min(1, Math.hypot(x - last.x, y - last.y) / 60);
      last = { x, y, t };
      trail.push({ x, y, t, s: 0.25 + speed * 0.45 });
      if (trail.length > 50) trail.shift();
      start();
    });

    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(host);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(host);
    resize(); draw(performance.now()); start();
  }
</script>

<style>
  .ascii-wave { position:absolute; inset:0; width:100%; height:100%; z-index:0; pointer-events:none;
    /* fade out toward the iPad so the demo stays clean */
    mask-image:linear-gradient(#000 55%, transparent 90%); -webkit-mask-image:linear-gradient(#000 55%, transparent 90%); }
</style>
