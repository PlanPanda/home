---
const testimonials = [
  {
    name: 'ไอซ์ ชัญญ์ธนัน ว.',
    role: 'ตัวแทนเอไอเอ',
    image: '/images/testimonials/ice.png',
    quote: 'ตั้งแต่ใช้ Solidplan.ai ได้เห็นภาพการทำงานของส่วนตัวและของทีม ยอดขายชัด วางแผนได้ดีขึ้นมาก การติดตามลูกค้าเป็นระบบ ดูมืออาชีพค่ะ',
  },
  {
    name: 'สกิป สุภาวดี ช.',
    role: 'ตัวแทนเอไอเอ',
    image: '/images/testimonials/skip.png',
    quote: 'เมื่อก่อนหลุด Follow-up บ่อยมาก แต่พอใช้ Solidplan.ai งานทุกอย่างเป็นระบบขึ้นทันที ทั้งดูทีม ดูยอด และปิดการขายได้ง่ายขึ้นกว่าเดิมมาก',
  },
  {
    name: 'หน่อย ศศิวิมล ค.',
    role: 'ตัวแทนเอไอเอ',
    image: '/images/testimonials/noi.png',
    quote: 'Solidplan.ai ทำให้บริหารตัวเองได้ในที่เดียว พอมีระบบที่ดี ชีวิตทำงานง่ายขึ้น',
  },
];
---

<section class="testimonials" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="shell">
    <header class="testimonials-head">
      <h2 id="testimonials-heading">เสียงจากผู้ใช้จริง</h2>
      <p>ประสบการณ์จากตัวแทนที่ใช้ Solid Plan ดูแลลูกค้าและทีม</p>
    </header>
    <div class="testimonials-grid">
      {testimonials.map((item) => <article class="testimonial">
        <blockquote><p>“{item.quote}”</p></blockquote>
        <footer>
          <span class="testimonial-portrait"><img src={item.image} alt={item.name} width="96" height="96" loading="lazy" /></span>
          <div><strong>{item.name}</strong><span>{item.role}</span></div>
        </footer>
      </article>)}
    </div>
  </div>
</section>

<style>
  .testimonials { padding:110px 0; background:#fff; scroll-margin-top:90px; }
  .testimonials-head { max-width:720px; margin:0 auto 48px; text-align:center; }
  .testimonials-head h2 { margin:0; font-size:48px; line-height:1.35; font-weight:600; text-wrap:balance; }
  .testimonials-head p { margin:14px 0 0; color:#6e6e73; font-size:18px; }
  .testimonials-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
  .testimonial { min-width:0; min-height:310px; padding:28px; border:1px solid #d2d2d7; border-radius:8px; display:flex; flex-direction:column; background:#fff; }
  blockquote { margin:0; }
  blockquote p { margin:0; color:#2c2c2e; font-size:17px; line-height:1.75; }
  footer { display:flex; align-items:center; gap:14px; margin-top:auto; padding-top:28px; }
  .testimonial-portrait { width:64px; height:64px; flex:none; overflow:hidden; border-radius:50%; background:#f5f5f7; }
  .testimonial-portrait img { display:block; width:100%; height:100%; object-fit:cover; object-position:center top; transform:scale(1.35); transform-origin:50% 24%; }
  footer strong,footer span { display:block; }
  footer strong { font-size:15px; line-height:1.4; }
  footer span { margin-top:3px; color:#6e6e73; font-size:12px; }
  @media (max-width:900px) { .testimonials-grid { grid-template-columns:1fr; }.testimonial { min-height:0; }.testimonials-head { text-align:left; margin-inline:0; }.testimonial footer { margin-top:24px; } }
  @media (max-width:700px) { .testimonials { padding-block:78px; }.testimonials-head { margin-bottom:32px; }.testimonials-head h2 { font-size:40px; }.testimonials-head p { font-size:16px; }.testimonial { padding:24px; } }
  @media (max-width:480px) { .testimonials-head h2 { font-size:32px; }.testimonials-grid { gap:12px; }.testimonial { padding:22px; }.testimonial blockquote p { font-size:16px; } }
</style>
