---
import Layout from '../layouts/Layout.astro';
import Line from '../components/icons/Line.astro';
const lineUrl = "https://line.me/R/ti/p/@675lurmh";
const signupUrl = "https://app.solidplan.ai/signup";
const plans=[
  {name:"ฟรี",desc:"เหมาะกับผู้ทดลองใช้",price:"ฟรี",limit:"ลูกค้าสูงสุด 10 คน",free:true},
  {name:"เริ่มต้น",desc:"เหมาะกับผู้เริ่มต้น",price:"15",limit:"ลูกค้าสูงสุด 200 คน"},
  {name:"มืออาชีพ",desc:"เหมาะกับมืออาชีพ",price:"30",limit:"ลูกค้าสูงสุด 1,000 คน"},
  {name:"ultra",desc:"เหมาะกับผู้เชี่ยวชาญ",price:"60",limit:"จำนวนลูกค้าไม่จำกัด"},
];
const included=[
  {title:"ผู้ช่วย AI",text:"อ่านกรมธรรม์ ถาม-ตอบจากข้อมูลในระบบ และบันทึกเพิ่ม แก้ไข ลบ โดยคุณยืนยันทุกครั้ง"},
  {title:"ลูกค้าและกิจกรรม",text:"รายชื่อลูกค้าและผู้มุ่งหวัง แท็ก ระดับความสนิท และประวัติการติดต่อ"},
  {title:"กรมธรรม์และไฟล์",text:"แบบประกัน ทุน เบี้ย วันครบชำระ สัญญาเพิ่มเติม และไฟล์เอกสารของลูกค้าแต่ละราย"},
  {title:"ปฏิทิน",text:"นัดหมายและวันสำคัญแบบรายสัปดาห์ เดือน และปี (ยังไม่มีการแจ้งเตือน)"},
  {title:"Dashboard",text:"ภาพรวมกิจกรรมทั้งปี ตารางความถี่กิจกรรม และสัดส่วน 5 ขั้นตอนการขาย"},
  {title:"ยอดขาย",text:"บันทึกยอดขาย ตั้งเป้าหมายรายปี และดูเปอร์เซ็นต์ความสำเร็จ"},
  {title:"ทีมงาน",text:"เพิ่มเพื่อนและเห็นสถิติกิจกรรมของกันและกัน เพื่อนเห็นเฉพาะสถิติรวม"},
  {title:"นำเข้า–ส่งออกข้อมูล",text:"ย้ายข้อมูลเดิมเข้าระบบ และส่งออกเป็น JSON/CSV ได้ตลอดเวลา"},
];
---
<Layout title="ราคาและแพ็คเกจ — Solid Plan" description="เริ่มฟรีสำหรับลูกค้าไม่เกิน 10 คน แพ็คเกจรายวันเริ่มต้น 15 Point ชำระแบบเติมเงินผ่าน QR Code ไม่ต้องใช้บัตรเครดิต การใช้ AI หักตามการใช้งานจริง สมัครใช้งานได้ทันที">
<section class="shell page-head"><h1>เริ่มใช้งานฟรี<br />จ่ายพอดีกับจำนวนลูกค้าของคุณ</h1><p>เริ่มฟรีสำหรับลูกค้าไม่เกิน 10 คน จ่ายเพิ่มเฉพาะเมื่อฐานลูกค้าโตขึ้นเท่านั้น และมีระบบเลือกแพ็คเกจอัตโนมัติที่ปรับให้พอดีกับลูกค้าของคุณเสมอ</p><div class="ref-cta-row"><a class="ref-pill" href={signupUrl}>สมัครสมาชิก</a><a class="ref-pill ghost" href={lineUrl}><Line size={18} /> คุยกับเราก่อนทาง LINE</a></div></section>
<section class="shell"><div class="plan-grid">{plans.map(plan=><article class="plan"><h2>{plan.name}</h2><p class="plan-price">{plan.free ? "ฟรี" : <>{plan.price}{" "}<span>Point/วัน</span></>}</p><small>{plan.desc}</small><p class="customers">{plan.limit}</p><a class="ref-pill" href={signupUrl} aria-label={`สมัครใช้งานแพ็คเกจ ${plan.name}`}>สมัครใช้งาน</a><a class="plan-ask" href={lineUrl} target="_blank" rel="noopener noreferrer"><Line size={14} /> ถามก่อนสมัครทาง LINE</a></article>)}</div>
<div class="pay-note"><span class="pay-note-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"></rect><rect width="5" height="5" x="16" y="3" rx="1"></rect><rect width="5" height="5" x="3" y="16" rx="1"></rect><path d="M21 16h-3a2 2 0 0 0-2 2v3"></path><path d="M21 21v.01"></path><path d="M12 7v3a2 2 0 0 1-2 2H7"></path><path d="M3 12h.01"></path><path d="M12 3h.01"></path><path d="M12 16v.01"></path><path d="M16 12h1"></path><path d="M21 12v.01"></path><path d="M12 21v-1"></path></svg></span><div><b>ชำระแบบเติมเงินผ่าน QR Code ใช้แค่ไหน เติมแค่นั้น</b><p>ไม่ต้องใช้บัตรเครดิต เติมยอดไว้เท่าที่ต้องการใช้ ค่าแพ็คเกจรายวันและการใช้งาน AI หักจาก Point ที่เติมไว้ โดยการใช้ AI คิดตามการใช้งานจริง ใช้เท่าไรหักเท่านั้น และดูยอดคงเหลือได้ตลอดในหน้าแพ็คเกจของแอป</p></div></div>
</section>
<section class="content-band"><div class="shell">
  <header class="included-head"><h2>แพ็คเกจรายวัน ใช้ได้ครบทุกฟีเจอร์</h2><p>เริ่มต้น มืออาชีพ และ ultra เปิดให้ใช้ฟีเจอร์ทั้งหมดเท่ากัน ต่างกันที่จำนวนลูกค้าที่จัดเก็บได้ ส่วนแพ็คเกจฟรีใช้งานฟีเจอร์พื้นฐานได้ฟรี</p></header>
  <div class="included-grid">{included.map(item=><div class="included-item"><span class="included-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span><b>{item.title}</b><p>{item.text}</p></div>)}</div>
</div></section>
<section class="content-band soft"><div class="shell faq"><h2>ก่อนเลือกแพ็คเกจ</h2><details><summary>ควรเลือกแพ็คเกจไหน?</summary><p>ฐานลูกค้ายังน้อย เริ่มที่แพ็คเกจฟรีได้เลย (ลูกค้าสูงสุด 10 คน) เมื่อฐานลูกค้าโตขึ้นจึงขยับไปเริ่มต้น (200 คน) มืออาชีพ (1,000 คน) หรือ ultra (ไม่จำกัด) และเปลี่ยนแพ็คเกจได้ทุกเมื่อ ในแอปยังมีเมนู "เลือกแพ็คเกจอัตโนมัติ" ที่ปรับแพ็คเกจให้พอดีกับจำนวนลูกค้าให้เอง หากยังไม่แน่ใจ คุยกับเราทาง LINE เพื่อเลือกให้เหมาะกับการใช้งาน</p></details><details><summary>ค่าแพ็คเกจคิดอย่างไร?</summary><p>แต่ละแพ็คเกจมีอัตราค่าใช้งานรายวันเป็น Point ตามที่แสดงบนการ์ด การชำระเงินเป็นระบบเติมเงินผ่าน QR Code เติมเท่าที่ใช้ ไม่ต้องใช้บัตรเครดิต คุณเติมยอดและตรวจยอดคงเหลือได้ตลอดในหน้าแพ็คเกจของแอป</p></details><details><summary>แพ็คเกจรวมการใช้ AI เท่าไร?</summary><p>การใช้งาน AI ไม่ได้จำกัดด้วยโควตาล่วงหน้า แต่หักจาก Point ที่คุณเติมไว้ตามการใช้งานจริง ใช้เท่าไรหักเท่านั้น</p></details><details><summary>มีทดลองใช้หรือไม่?</summary><p>เงื่อนไขทดลองใช้ยังอยู่ระหว่างจัดทำ คุณสมัครใช้งานจริงได้ทันทีที่ app.solidplan.ai หรือทัก LINE เพื่อขอดูการทำงานก่อนตัดสินใจ</p></details><details><summary>ต้องการดูการทำงานก่อนสมัคร?</summary><p>เพิ่มเพื่อนใน LINE แล้วส่งงานที่ต้องการให้ Solid Plan ช่วย เช่น อ่านกรมธรรม์หรือเตรียมข้อมูลก่อนเข้าพบลูกค้า</p></details></div></section>
<section class="content-band dark"><div class="shell"><h2>เริ่มใช้งานได้วันนี้</h2><p>เริ่มฟรีสำหรับลูกค้าไม่เกิน 10 คน สมัคร 5 นาที เริ่มเก็บข้อมูลลูกค้าไว้ในที่เดียวตั้งแต่ลูกค้าคนแรก</p><div class="ref-cta-row"><a class="ref-pill inverse" href={signupUrl}>สมัครสมาชิก</a><a class="ref-pill ghost inverse" href={lineUrl}><Line size={18} /> เพิ่มเพื่อนใน LINE</a></div></div></section>
</Layout>

<style>
  .plan h2 { margin-bottom:16px; }
  .plan .customers { margin:18px 0 26px; }
  .plan-ask { display:flex; align-items:center; justify-content:center; gap:6px; margin-top:12px; color:var(--muted); font-size:13.5px; }
  .plan-ask svg { flex:none; opacity:.8; }
  .plan-ask:hover { color:#15734b; }
  .pay-note { display:grid; grid-template-columns:26px 1fr; column-gap:16px; margin-top:26px; padding:22px 26px; border:1px solid var(--ref-hair); border-radius:8px; background:var(--ref-soft); }
  .pay-note-icon { margin-top:2px; color:#15734b; }
  .pay-note-icon svg { width:22px; height:22px; }
  .pay-note b { font-size:16.5px; }
  .pay-note p { margin:6px 0 0; color:var(--muted); font-size:14.5px; line-height:1.7; max-width:none; }
  @media (max-width:640px) { .pay-note { padding:18px 20px; } }
  .included-head { max-width:720px; }
  .included-head p { margin-top:0; }
  .included-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 56px; margin-top:14px; }
  .included-item { display:grid; grid-template-columns:26px 1fr; column-gap:14px; padding:20px 0; border-bottom:1px solid var(--ref-edge); }
  .included-check { grid-row:1; display:grid; place-items:center; width:24px; height:24px; margin-top:3px; border-radius:50%; background:#111; }
  .included-check svg { width:13px; height:13px; fill:none; stroke:#fff; stroke-width:2.4; stroke-linecap:round; stroke-linejoin:round; }
  .included-item b { font-size:16.5px; }
  .included-item p { grid-column:2; margin:4px 0 0; color:var(--muted); font-size:14.5px; line-height:1.7; max-width:none; }
  @media (max-width:900px) { .included-grid { grid-template-columns:1fr; gap:0; } }
</style>
