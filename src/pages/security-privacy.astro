---
import Layout from "../layouts/Layout.astro";

const APP_SIGNUP = "https://app.solidplan.ai/signup";

const STANDARDS = [
  {
    name: "SOC 2 Type II",
    image: "/images/aicpa.svg",
    meaning:
      "ข้อมูลของคุณจัดเก็บบนโครงสร้างพื้นฐานที่ผ่านการตรวจสอบความปลอดภัยจากผู้ประเมินภายนอกอย่างสม่ำเสมอ",
  },
  {
    name: "HIPAA",
    image: "/images/hippa.svg",
    meaning:
      "ระบบจัดเก็บข้อมูลอยู่บนโครงสร้างพื้นฐานที่สอดคล้องกับแนวทางคุ้มครองข้อมูลอ่อนไหวระดับเดียวกับภาคการแพทย์",
  },
  {
    name: "GDPR",
    image: "/images/gdpr.svg",
    meaning:
      "ออกแบบตามหลักสิทธิความเป็นส่วนตัวของเจ้าของข้อมูลอย่างโปร่งใส และตรวจสอบได้",
  },
];
---

<Layout>
  <main class="min-h-screen bg-canvas">
    <section class="max-w-6xl mx-auto px-6 pt-14 pb-10 md:pt-20 md:pb-14">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-muted no-underline hover:text-ink transition"
      >
        <i class="fa-solid fa-arrow-left"></i>
        กลับสู่หน้าแรก
      </a>

      <div class="mt-8 md:mt-10">
        <p
          class="text-xs font-bold tracking-[0.15em] uppercase text-muted-soft mb-4"
        >
          TRUST CENTER
        </p>
        <h1
          class="text-4xl md:text-6xl font-semibold tracking-tight leading-tight mb-6"
        >
          ลูกค้าของคุณ คือทรัพย์สินของคุณ
        </h1>
        <p class="text-lg md:text-xl text-body max-w-3xl leading-relaxed mb-6">
          Solid Plan ถูกสร้างขึ้นบนแนวคิดที่ว่า "ความสัมพันธ์ระหว่างคุณกับลูกค้า คือสิ่งสำคัญที่สุด"
        </p>
        <p class="text-lg text-body max-w-3xl leading-relaxed mb-6">
          เราจึงให้ความสำคัญกับความปลอดภัยของข้อมูลในระดับเดียวกับสถาบันการเงินและองค์กรระดับโลก เพื่อให้คุณสามารถดูแลลูกค้าได้อย่างมั่นใจในทุกขั้นตอน
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 pb-8 md:pb-10">
      <div class="bg-white rounded-3xl p-8 md:p-10 border border-hairline/60">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">
          ความปลอดภัยที่ออกแบบมาเพื่ออาชีพตัวแทน
        </h2>
        <p class="text-lg text-body leading-relaxed mb-5">
          เราเข้าใจว่าตัวแทนหลายคนกังวลว่า "ถ้านำข้อมูลลูกค้ามาเก็บไว้ในระบบ จะปลอดภัยหรือไม่"
        </p>
        <p class="text-muted leading-relaxed mb-6">
          Solid Plan จึงถูกออกแบบให้คุณ:
        </p>
        <ul class="space-y-3 text-body">
          <li class="flex gap-3">
            <span class="text-ink font-semibold flex-shrink-0">•</span>
            <span>เป็นเจ้าของข้อมูลลูกค้าของคุณเอง</span>
          </li>
          <li class="flex gap-3">
            <span class="text-ink font-semibold flex-shrink-0">•</span>
            <span>ควบคุมได้ว่าใครเข้าถึงข้อมูลอะไรได้บ้าง</span>
          </li>
          <li class="flex gap-3">
            <span class="text-ink font-semibold flex-shrink-0">•</span>
            <span>มั่นใจได้ว่าข้อมูลจะไม่สูญหาย</span>
          </li>
          <li class="flex gap-3">
            <span class="text-ink font-semibold flex-shrink-0">•</span>
            <span>และไม่มีการนำข้อมูลลูกค้าไปใช้โดยไม่ได้รับอนุญาต</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 pb-8 md:pb-10">
      <div class="rounded-3xl p-8 md:p-10 border border-hairline/60 bg-white">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-8">
          Our Promise
        </h2>
        
        <div class="grid md:grid-cols-2 gap-6 md:gap-8">
          <div class="pb-6 md:pb-8 md:border-r md:border-hairline/60">
            <div class="flex items-start gap-3 mb-3">
              <span class="text-2xl">🔒</span>
              <h3 class="text-lg font-semibold text-ink">ข้อมูลลูกค้าเป็นของคุณ</h3>
            </div>
            <p class="text-body text-sm leading-relaxed">
              ข้อมูลลูกค้าทั้งหมดเป็นของคุณเสมอ
              Solid Plan ไม่มีสิทธิ์นำข้อมูลไปขาย ติดต่อ หรือใช้เพื่อวัตถุประสงค์อื่นโดยเด็ดขาด
            </p>
          </div>

          <div class="pb-6 md:pb-8 md:border-r md:border-hairline/60">
            <div class="flex items-start gap-3 mb-3">
              <span class="text-2xl">👁️</span>
              <h3 class="text-lg font-semibold text-ink">คุณควบคุมการเข้าถึงได้</h3>
            </div>
            <p class="text-body text-sm leading-relaxed">
              เลือกได้ว่าใครในทีมสามารถเห็นข้อมูลอะไรได้บ้าง
              ทุกการเข้าถึงข้อมูลมีการบันทึกเพื่อตรวจสอบย้อนหลัง
            </p>
          </div>

          <div class="pb-6 md:pb-8">
            <div class="flex items-start gap-3 mb-3">
              <span class="text-2xl">💾</span>
              <h3 class="text-lg font-semibold text-ink">ข้อมูลไม่สูญหาย</h3>
            </div>
            <p class="text-body text-sm leading-relaxed">
              ข้อมูลถูกสำรองอัตโนมัติทุกวันในสภาพแวดล้อมที่ปลอดภัย
              พร้อมระบบกู้คืนข้อมูลเมื่อเกิดเหตุไม่คาดคิด
            </p>
          </div>

          <div class="pb-6 md:pb-8">
            <div class="flex items-start gap-3 mb-3">
              <span class="text-2xl">🏛️</span>
              <h3 class="text-lg font-semibold text-ink">มาตรฐานระดับสถาบันการเงิน</h3>
            </div>
            <p class="text-body text-sm leading-relaxed">
              Solid Plan ทำงานบนโครงสร้างพื้นฐานจากผู้ให้บริการระดับโลก ที่ผ่านมาตรฐานด้านความปลอดภัย เช่น SOC 2, HIPAA และ GDPR
              <br /><br />
              มาตรฐานเดียวกับที่องค์กรด้านการเงินและการแพทย์ชั้นนำระดับโลกเลือกใช้
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-8 md:py-10">
      <div class="rounded-3xl p-8 md:p-10 border border-hairline/60 bg-surface-soft">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">
          Security & Privacy
        </h2>
        <p class="text-body leading-relaxed">
          ความปลอดภัยของข้อมูล<br class="md:hidden" /><span class="hidden md:inline">ไม่ใช่แค่เรื่องของระบบ</span>
          <br />
          แต่คือความรับผิดชอบต่อความไว้วางใจ<br class="md:hidden" />
          <span class="hidden md:inline">ที่ลูกค้าของคุณมอบให้ในทุกบทสนทนา</span>
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 pb-8 md:pb-10">
      <div class="bg-white rounded-3xl p-8 md:p-10 border border-hairline/60">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">
          Who can see my data?
        </h2>
        <p class="text-lg text-body leading-relaxed mb-5">
          ไม่มีใครสามารถเห็นข้อมูลลูกค้าของคุณได้ นอกจากคุณและทีมที่คุณอนุญาตเท่านั้น
        </p>
        <p class="text-muted leading-relaxed">
          แม้แต่ทีมงานของ Solid Plan ก็ไม่สามารถเข้าถึงข้อมูลของคุณได้โดยไม่ได้รับอนุญาต
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-8 md:py-10">
      <div
        class="bg-surface-soft rounded-3xl p-8 md:p-10 border border-hairline/60"
      >
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">
          What happens if something goes wrong?
        </h2>
        <p class="text-lg text-body leading-relaxed mb-5">
          ข้อมูลของคุณถูกสำรองไว้อย่างต่อเนื่องในระบบที่ปลอดภัย
        </p>
        <p class="text-muted leading-relaxed">
          เพื่อให้คุณมั่นใจได้ว่า แม้เกิดเหตุไม่คาดคิด ธุรกิจและข้อมูลลูกค้าของคุณจะยังคงได้รับการดูแลอย่างต่อเนื่อง
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 pt-8 pb-14 md:pt-10 md:pb-20">
      <div class="rounded-3xl p-8 md:p-10 border border-hairline/60 bg-white">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-3">
          Compliance
        </h2>
        <p class="text-muted mb-8 leading-relaxed">
          Solid Plan ถูกพัฒนาบนโครงสร้างพื้นฐานที่ผ่านมาตรฐานความปลอดภัยระดับสากล เพื่อให้การจัดเก็บและดูแลข้อมูลลูกค้าเป็นระบบ โปร่งใส และตรวจสอบได้
        </p>

        <div class="grid md:grid-cols-3 gap-4 md:gap-5">
          {
            STANDARDS.map((standard) => (
              <article class="rounded-2xl border border-hairline/60 bg-surface-card p-6">
                <img
                  src={standard.image}
                  alt={`${standard.name} compliance badge`}
                  class="h-10 mb-4 opacity-70"
                />
                <h3 class="text-lg font-bold tracking-tight mb-2 text-ink">
                  {standard.name}
                </h3>
                <p class="text-sm text-body leading-relaxed">
                  {standard.meaning}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 pb-24">
      <div
        class="bg-surface-strong rounded-4xl p-8 md:p-10 text-center border border-hairline/60"
      >
        <h2
          class="text-3xl md:text-4xl font-semibold tracking-tight leading-tight mb-5"
        >
          ปกป้องความสัมพันธ์
          <br class="hidden md:block" />
          ที่คุณสร้างมาอย่างตั้งใจ
        </h2>
        <p class="text-body text-lg max-w-3xl mx-auto leading-relaxed mb-7">
          เพราะเราเชื่อว่า "ความไว้วางใจของลูกค้า" คือสิ่งที่มีค่าที่สุดในอาชีพนี้
          <br class="hidden md:block" />
          <br class="hidden md:block" />
          Solid Plan จึงถูกออกแบบมา เพื่อช่วยให้คุณดูแลลูกค้าได้อย่างมั่นใจและปลอดภัยในทุกวัน
        </p>
        <a
          href={APP_SIGNUP}
          class="bg-ink text-white text-base font-semibold px-8 py-4 rounded-2xl inline-flex items-center gap-2 no-underline hover:bg-ink/80 transition"
        >
          เริ่มต้นใช้งานฟรี
          <i class="fa-solid fa-chevron-right text-xs"></i>
        </a>
      </div>
    </section>
  </main>
</Layout>
