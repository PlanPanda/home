---
import Layout from '../layouts/Layout.astro';
import Line from '../components/icons/Line.astro';
import ExternalLink from '../components/icons/ExternalLink.astro';
const principles = [
  { icon: "export", title: "ข้อมูลลูกค้าเป็นของคุณ", text: "ส่งออกลูกค้า กิจกรรม และยอดขายเป็นไฟล์ JSON หรือ CSV ได้ตลอดเวลา ข้อมูลของคุณไม่ถูกผูกไว้กับ Solid Plan" },
  { icon: "check", title: "ทุกการบันทึกผ่านการยืนยัน", text: "ผู้ช่วย AI จะขออนุมัติก่อนเพิ่ม แก้ไข หรือลบข้อมูลทุกครั้ง คุณเห็นรายการที่จะบันทึกเต็ม ๆ ก่อนกดยืนยันเสมอ" },
  { icon: "eye", title: "คุณกำหนดว่าใครเข้าถึงได้", text: "เพื่อนในทีมเห็นเพียงสถิติกิจกรรมรวม ไม่เห็นข้อมูลลูกค้าของกันและกัน และคุณเปิดโหมดผู้มองว่างเมื่อต้องให้คนอื่นดูหน้าจอ" },
  { icon: "sparkles", title: "ส่งให้ AI เฉพาะที่จำเป็น", text: "เมื่อคุณสั่งงาน ระบบเลือกเฉพาะข้อมูลที่เกี่ยวข้องกับคำถามเพื่อส่งประมวลผล ไม่ส่งฐานข้อมูลลูกค้าทั้งหมดไปพร้อมกัน" },
];
const ICONS: Record<string,string> = {
  "export": '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M12 12v6"></path><path d="m15 15-3-3-3 3"></path></svg>',
  check: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>',
  eye: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>',
  sparkles: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>',
};
---
<Layout title="การดูแลข้อมูล — Solid Plan" description="เราดูแลข้อมูลให้คุณดูแลลูกค้า ทุกการบันทึกด้วย AI ต้องผ่านการยืนยันของคุณ นำเข้า–ส่งออกข้อมูลได้ตลอด และโปร่งใสเรื่องผู้ให้บริการที่เกี่ยวข้อง">
<section class="shell page-head"><h1>เราดูแลข้อมูล<br />ให้คุณดูแลลูกค้า</h1><p>ผู้ช่วย AI เตรียมข้อมูลให้คุณตรวจ ก่อนการเพิ่ม แก้ไข หรือลบข้อมูลทุกครั้ง และคุณนำข้อมูลออกไปใช้ต่อได้ตลอดเวลา</p></section>

<section class="band dark-principles"><div class="shell">
  <h2>หลักการที่ออกแบบไว้ในระบบ</h2>
  <div class="principle-grid">{principles.map(p => <article><span class="p-icon" aria-hidden="true" set:html={ICONS[p.icon]} /><h3>{p.title}</h3><p>{p.text}</p></article>)}</div>
</div></section>

<section class="content-band"><div class="shell split"><div><h2>AI ขออนุมัติก่อนบันทึกเสมอ</h2><p>ไม่ว่าจะเป็นการสร้างกรมธรรม์จากไฟล์ เพิ่มลูกค้าใหม่ แก้ไขข้อมูล หรือลบรายการ ผู้ช่วย AI จะแสดงสิ่งที่กำลังจะบันทึกให้คุณตรวจก่อน รวมถึงระบุช่องที่ไม่พบในเอกสารและค่าเริ่มต้นของระบบอย่างชัดเจน</p><p>โดยเฉพาะข้อมูลการเงินอย่างกรมธรรม์ ระบบจะขออนุมัติก่อนสร้างทุกครั้ง</p></div><div class="product-example"><div class="example-header"><b>ยืนยันการสร้างกรมธรรม์</b></div><div class="example-body"><p class="example-question">เพิ่มกรมธรรม์ให้คุณกานต์ พูนสุข จากไฟล์แนบ</p><dl><div><dt>ลูกค้า</dt><dd>คุณกานต์ พูนสุข</dd></div><div><dt>แบบประกัน</dt><dd>ตลอดชีพ ชำระเบี้ย 20 ปี</dd></div><div><dt>เบี้ยประกัน</dt><dd>24,000 บาท / ปี</dd></div><div><dt>ข้อมูลบางช่อง</dt><dd>ไม่พบในเอกสาร</dd></div></dl><div class="example-status">รอผู้ใช้ตรวจและยืนยัน · ยังไม่ได้บันทึก</div></div></div></div></section>

<section class="content-band soft"><div class="shell split rev"><div><h2>ตั้งค่าความเป็นส่วนตัวได้เองในแอป</h2><p>เรื่องความเป็นส่วนตัวไม่ได้ซ่อนอยู่ในนโยบาย แต่อยู่ในหน้าจอที่คุณใช้ทุกวัน</p><ul class="feature-list"><li>บันทึกสถานะยินยอม PDPA รายลูกค้า</li><li>เปิดโหมดผู้มองว่างเมื่อต้องให้เพื่อนร่วมงานดูหน้าจอ</li><li>ซ่อนสถิติของคุณจากหน้าทีมงานได้ ตามที่คุณตั้ง</li></ul></div><figure class="shot"><img src="/images/app/customer_more_detail.jpg" alt="หน้าจอข้อมูลลูกค้าในแอป Solid Plan แสดงแท็ก ระดับความสนิท สถานะลูกค้า และตัวเลือกยินยอม PDPA" width="1600" height="1078" loading="lazy" /><figcaption>หน้าข้อมูลลูกค้า: แท็ก ระดับความสนิท สถานะ และการยินยอม PDPA</figcaption></figure></div></section>

<section class="content-band"><div class="shell">
  <header class="io-head"><h2>นำเข้าได้เร็ว ส่งออกได้ตลอด</h2><p>ข้อมูลของคุณเข้ามาได้โดยไม่ต้องเริ่มจากศูนย์ และออกไปได้เมื่อไรก็ได้ เราไม่ล็อกข้อมูลของคุณไว้ในระบบ</p></header>
  <div class="io-grid">
    <div class="io-col">
      <h3>นำเข้าข้อมูลเดิม</h3>
      <ul class="io-list">
        <li>อัปโหลดลูกค้า กิจกรรม และยอดขายจากไฟล์ JSON หรือ CSV — ย้ายฐานลูกค้าเดิมเข้าระบบได้ในไม่กี่คลิก ไม่ต้องพิมพ์ซ้ำ ระบบตรวจไฟล์และแจ้งผลก่อนนำเข้าจริงทุกครั้ง</li>
        <li>อยากให้ AI ช่วยสร้างไฟล์นำเข้า ก็คัดลอกพรอมต์ที่ระบบเตรียมไว้ไปวางใน AI ที่คุณใช้ พร้อมคำอธิบายว่าข้อมูลแต่ละช่องคืออะไร ค่าไหนจำเป็น ค่าไหนเป็นทางเลือก AI จะแปลงข้อมูลจาก Excel หรือ Google Sheets เป็นไฟล์ที่ระบบรับได้ให้</li>
      </ul>
      <p class="io-links"><a href="https://docs.solidplan.ai/import/" target="_blank" rel="noopener noreferrer">วิธีนำเข้าข้อมูล <ExternalLink size={14} /></a><a href="https://docs.solidplan.ai/import-ai/" target="_blank" rel="noopener noreferrer">ใช้ AI ช่วยแปลงไฟล์ <ExternalLink size={14} /></a></p>
    </div>
    <div class="io-col">
      <h3>ส่งออกไปใช้ต่อ</h3>
      <ul class="io-list">
        <li>ส่งออกลูกค้า กิจกรรม ยอดขาย หรือทุกอย่างในไฟล์เดียว เป็น JSON หรือ CSV พร้อมดูจำนวนข้อมูลก่อนดาวน์โหลด สำรองข้อมูลได้ตลอดเวลา</li>
        <li>เมื่อต้องการให้ AI วิเคราะห์ข้อมูล เรามีคำอธิบายของทุก field ในไฟล์ส่งออกให้คัดลอกแนบไปด้วย เช่น ให้ AI หาลูกค้าที่ยังไม่ได้ติดต่อ หรือสรุปแนวโน้มยอดขายรายเดือน</li>
      </ul>
      <p class="io-links"><a href="https://docs.solidplan.ai/export/" target="_blank" rel="noopener noreferrer">วิธีส่งออกข้อมูล <ExternalLink size={14} /></a><a href="https://docs.solidplan.ai/export-ai/" target="_blank" rel="noopener noreferrer">ใช้ AI วิเคราะห์ข้อมูลที่ส่งออก <ExternalLink size={14} /></a></p>
    </div>
  </div>
</div></section>

<section class="content-band"><div class="shell">
  <header class="infra-head"><h2>โครงสร้างพื้นฐานและผู้ให้บริการที่เกี่ยวข้อง</h2><p>Solid Plan ให้บริการโดย Apirak Panatkool เราโปร่งใสเรื่องบริการของบุคคลที่สามที่ใช้ในการทำงานของระบบ</p></header>
  <div class="infra-grid">
    <article class="infra-card"><h3>Railway</h3><p class="infra-role">โฮสติ้งแอปและฐานข้อมูล</p><p>Solid Plan โฮสต์บน Railway ซึ่งได้รับการรับรอง SOC 2 Type II และ SOC 3 โดยการรับรองนี้เป็นของ Railway ในฐานะผู้ให้บริการโครงสร้างพื้นฐาน ไม่ใช่การรับรอง Solid Plan</p><div class="compliance-mark"><img src="/images/aicpa.svg" alt="AICPA" width="40" height="40" /><span><strong>SOC 2 Type II · SOC 3</strong><small>Railway infrastructure</small></span></div></article>
    <article class="infra-card"><h3>ผู้ให้บริการโมเดล AI</h3><p class="infra-role">ประมวลผลผ่าน OpenRouter</p><p>เมื่อคุณสั่งให้ AI ช่วย ระบบส่งเฉพาะข้อมูลที่เกี่ยวข้องกับคำสั่งนั้นผ่าน OpenRouter ไปยังผู้ให้บริการโมเดลที่เลือกใช้ ข้อมูลส่วนนี้อยู่ภายใต้นโยบายความเป็นส่วนตัวของผู้ให้บริการโมเดลด้วย</p></article>
  </div>
</div></section>

<section class="content-band soft"><div class="shell"><h2>นโยบายฉบับเต็ม</h2><p>นโยบายฉบับปรับปรุงกำลังอยู่ระหว่างตรวจรายละเอียดเรื่องสถานที่ประมวลผล การใช้ข้อมูลของผู้ให้บริการโมเดล ระยะเก็บข้อมูล และกระบวนการหลังปิดบัญชี ก่อนนำข้อมูลอ่อนไหวเข้าใช้งาน สอบถามรายละเอียดกับเราได้โดยตรง</p><div class="ref-cta-row"><a class="ref-pill ghost" href="/privacy-policy">อ่านร่างนโยบายความเป็นส่วนตัว</a><a class="ref-pill ghost" href="/terms-of-service">อ่านร่างข้อกำหนด</a></div></div></section>

<section class="band dark-final"><div class="shell"><h2>สอบถามเรื่องข้อมูลของคุณ</h2><p>สำหรับคำถามเรื่องข้อมูลส่วนบุคคล การเข้าถึง การแก้ไข การส่งออก หรือการลบข้อมูล ติดต่อ Apirak Panatkool ได้โดยตรง</p><div class="ref-cta-row"><a class="ref-pill inverse" href="mailto:apirak@solidplan.ai">apirak@solidplan.ai</a><a class="ref-pill ghost inverse" href="https://line.me/R/ti/p/@675lurmh"><Line size={18} /> เพิ่มเพื่อนใน LINE</a></div></div></section>
</Layout>

<style>
  .band { padding-block:72px; }
  .dark-principles { background:#111; color:#fff; }
  .dark-principles h2 { margin:0 0 40px; font-size:32px; font-weight:600; }
  .principle-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:0; border-block:1px solid #303033; }
  .principle-grid article { padding:30px 28px 34px; }
  .principle-grid article + article { border-left:1px solid #303033; }
  .p-icon { display:grid; place-items:center; width:42px; height:42px; border:1px solid #3a3a3c; border-radius:10px; color:#fff; }
  .p-icon :global(svg) { width:21px; height:21px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .principle-grid h3 { margin:22px 0 10px; font-size:19px; line-height:1.45; }
  .principle-grid p { margin:0; color:#b9b9bf; font-size:14.5px; line-height:1.75; max-width:none; }
  .split.rev > :global(:first-child) { order:2; }
  .shot { margin:0; }
  .shot img { display:block; width:100%; height:auto; border:1px solid var(--ref-hair); border-radius:12px; box-shadow:0 24px 60px -42px rgba(0,0,0,.4); background:#fff; }
  .shot figcaption { margin-top:12px; color:var(--muted); font-size:14px; }
  .io-head { max-width:720px; }
  .io-head p { margin-top:0; }
  .io-grid { display:grid; grid-template-columns:1fr 1fr; margin-top:34px; }
  .io-col { padding:0 48px 0 0; }
  .io-col + .io-col { border-left:1px solid var(--ref-hair); padding:0 0 0 48px; }
  .io-col h3 { margin:0; font-size:21px; }
  .io-list { margin:16px 0 0; padding-left:20px; color:var(--muted); }
  .io-list li { margin:12px 0; line-height:1.75; }
  .io-links { display:flex; flex-wrap:wrap; gap:8px 24px; margin:18px 0 0!important; }
  .io-links a { display:inline-flex; align-items:center; gap:6px; color:#111; font-weight:600; font-size:14.5px; border-bottom:1px solid var(--ref-hair); }
  .io-links a:hover { border-color:#111; }
  .infra-head { max-width:760px; }
  .infra-head p { margin-top:0; }
  .infra-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:34px; }
  .infra-card { padding:28px 26px 30px; border:1px solid var(--ref-hair); border-radius:12px; background:var(--ref-soft); }
  .infra-card h3 { margin:0; font-size:20px; }
  .infra-role { margin:4px 0 12px!important; color:#111!important; font-weight:600; font-size:13.5px!important; max-width:none; }
  .infra-card > p:not(.infra-role) { margin:0; color:var(--muted); font-size:14.5px; line-height:1.75; max-width:none; }
  .compliance-mark { display:flex; align-items:center; gap:10px; margin-top:20px; width:max-content; max-width:100%; padding:8px 12px 8px 9px; border-radius:8px; background:#fff; color:#111; }
  .compliance-mark img { flex:none; }
  .compliance-mark strong, .compliance-mark small { display:block; }
  .compliance-mark strong { font-size:12px; line-height:1.35; }
  .compliance-mark small { margin-top:2px; color:#525258; font-size:10px; line-height:1.3; }
  .dark-final { background:#111; color:#fff; }
  .dark-final h2 { margin:0; font-size:32px; font-weight:600; }
  .dark-final p { margin:16px 0 0; color:#b9b9c0; }
  @media (max-width:900px) { .principle-grid { grid-template-columns:1fr 1fr; } .principle-grid article:nth-child(odd) { border-left:0; } .principle-grid article:nth-child(n+3) { border-top:1px solid #303033; } .infra-grid { grid-template-columns:1fr; } .io-grid { grid-template-columns:1fr; } .io-col { padding:0; } .io-col + .io-col { border-left:0; border-top:1px solid var(--ref-hair); margin-top:32px; padding:32px 0 0; } }
  @media (max-width:640px) { .principle-grid { grid-template-columns:1fr; border:0; } .principle-grid article { padding:26px 0; border-left:0!important; border-top:1px solid #303033; } .principle-grid article:first-child { border-top:0; } .split.rev > :global(:first-child) { order:0; } }
</style>
