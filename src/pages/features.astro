<script>
  const stage = document.querySelector<HTMLElement>("[data-slideshow]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (stage) {
    const slides = [...stage.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...stage.querySelectorAll<HTMLButtonElement>(".dot")];
    const caption = document.querySelector<HTMLElement>("[data-slide-caption]");
    const ipad = stage.querySelector<HTMLElement>(".ipad");
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const goTo = (target: number, byUser = false) => {
      index = (target + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === index);
        slide.setAttribute("aria-hidden", i === index ? "false" : "true");
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === index);
        dot.setAttribute("aria-current", i === index ? "true" : "false");
      });
      const text = slides[index].dataset.caption ?? "";
      if (caption) {
        if (reduceMotion.matches) { caption.textContent = text; }
        else {
          caption.style.opacity = "0";
          setTimeout(() => { caption.textContent = text; caption.style.opacity = "1"; }, 180);
        }
      }
      if (byUser) restart();
    };

    const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
    const start = () => { if (!reduceMotion.matches && !timer) timer = setInterval(() => goTo(index + 1), 5200); };
    const restart = () => { stop(); start(); };

    stage.querySelector(".slide-nav.prev")?.addEventListener("click", () => goTo(index - 1, true));
    stage.querySelector(".slide-nav.next")?.addEventListener("click", () => goTo(index + 1, true));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i, true)));
    stage.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); goTo(index - 1, true); }
      if (e.key === "ArrowRight") { e.preventDefault(); goTo(index + 1, true); }
    });
    let swipeX: number | null = null;
    stage.addEventListener("pointerdown", (e) => { swipeX = e.clientX; });
    stage.addEventListener("pointerup", (e) => {
      if (swipeX === null) return;
      const dx = e.clientX - swipeX;
      if (Math.abs(dx) > 40) goTo(index + (dx < 0 ? 1 : -1), true);
      swipeX = null;
    });
    stage.addEventListener("mouseenter", stop);
    stage.addEventListener("mouseleave", restart);
    stage.addEventListener("focusin", stop);
    stage.addEventListener("focusout", restart);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : restart()));
    start();

    const MAX_DEG = 6;
    let tx = 0, ty = 0, cx = 0, cy = 0, raf: number | null = null;
    const animate = () => {
      cx += (tx - cx) * 0.09;
      cy += (ty - cy) * 0.09;
      if (ipad) ipad.style.transform = `rotateX(${cy.toFixed(3)}deg) rotateY(${cx.toFixed(3)}deg)`;
      if (Math.abs(tx - cx) > 0.01 || Math.abs(ty - cy) > 0.01) raf = requestAnimationFrame(animate);
      else raf = null;
    };
    const tilt = () => { if (raf === null) raf = requestAnimationFrame(animate); };
    const canHover = window.matchMedia("(hover: hover)").matches;
    if (ipad && canHover && !reduceMotion.matches) {
      stage.addEventListener("mousemove", (e) => {
        const rect = stage.getBoundingClientRect();
        const nx = (e.clientX - rect.left) / rect.width - 0.5;
        const ny = (e.clientY - rect.top) / rect.height - 0.5;
        tx = nx * MAX_DEG * 2;
        ty = -ny * MAX_DEG * 2;
        stage.style.setProperty("--gx", `${((nx + 0.5) * 100).toFixed(1)}%`);
        stage.style.setProperty("--gy", `${((ny + 0.5) * 100).toFixed(1)}%`);
        tilt();
      });
      stage.addEventListener("mouseleave", () => { tx = 0; ty = 0; tilt(); });
    }
    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) {
        stop();
        tx = 0; ty = 0; cx = 0; cy = 0;
        if (ipad) ipad.style.transform = "";
      } else start();
    });
  }
</script>

