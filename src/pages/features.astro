---
import Layout from '../layouts/Layout.astro';
import ExternalLink from '../components/icons/ExternalLink.astro';
import Line from '../components/icons/Line.astro';
const lineUrl = "https://line.me/R/ti/p/@675lurmh";
const signupUrl = "https://app.solidplan.ai/signup";
const docs = (path: string) => `https://docs.solidplan.ai${path}`;

/* Lucide icon paths (lucide.dev) — same icon set the app uses */
const ICONS: Record<string,string> = {
  chat: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>',
  file: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>',
  check: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>',
  search: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>',
  dashboard: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg>',
  trend: '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>',
  team: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="10" r="3"></circle><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"></path></svg>',
  "import": '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M12 18v-6"></path><path d="m9 15 3 3 3-3"></path></svg>',
  "export": '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M12 12v6"></path><path d="m15 15-3-3-3 3"></path></svg>',
  shield: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg>',
};

const aiPoints = [
  { icon: "chat", title: "ตอบจากข้อมูลในระบบ", text: "คำตอบมาจากลูกค้า กรมธรรม์ และประวัติการติดต่อของคุณ ไม่ต้องป้อนข้อมูลซ้ำ" },
  { icon: "file", title: "อ่านไฟล์กรมธรรม์", text: "แนบ PDF แล้วให้ AI จดรายละเอียดลงในระบบให้เอง" },
  { icon: "check", title: "บันทึกโดยคุณยืนยัน", text: "เพิ่ม แก้ไข หรือลบอะไรก็ตาม AI เตรียมรายการให้ตรวจก่อนทุกครั้ง" },
  { icon: "search", title: "ค้น นับ และจัดกลุ่ม", text: "ถามว่าใครควรติดตาม ใครเกิดเดือนนี้ ได้รายชื่อจากข้อมูลจริง" },
];
const tools = [
  { icon: "dashboard", title: "Dashboard", text: "เห็นภาพรวมงานทั้งปีในพริบตา ตารางความถี่กิจกรรมแบบ heatmap และกราฟสัดส่วน 5 ขั้นตอนการขาย พร้อมลูกค้าที่เพิ่มล่าสุด", href: docs("/daily/dashboard/") },
  { icon: "trend", title: "ยอดขาย", text: "บันทึกยอดขายที่ปิดได้ ตั้งเป้าหมายรายปีตามระดับของคุณ แล้วดูเปอร์เซ็นต์ความสำเร็จที่คำนวณให้อัตโนมัติ", href: docs("/sales/sales-records/") },
  { icon: "team", title: "ทีมงาน", text: "เพิ่มเพื่อนและเห็นสถิติกิจกรรมของกันและกันเพื่อชวนกันทำงาน เพื่อนจะเห็นเฉพาะสถิติรวม ไม่เห็นข้อมูลลูกค้าของคุณ", href: docs("/team/overview/") },
  { icon: "import", title: "นำเข้าข้อมูล", text: "ย้ายข้อมูลลูกค้า กิจกรรม และยอดขายเดิมจากไฟล์ JSON/CSV พร้อมพรอมต์ที่ระบบเตรียมไว้ให้คัดลอกไปใช้ AI แปลงไฟล์", href: docs("/import/") },
  { icon: "export", title: "ส่งออกข้อมูล", text: "ส่งออกข้อมูลของคุณเป็น JSON หรือ CSV ได้ตลอดเวลา เพื่อสำรองข้อมูลหรือนำไปวิเคราะห์ต่อในเครื่องมืออื่น", href: docs("/export/") },
  { icon: "shield", title: "ความเป็นส่วนตัว", text: "บันทึกสถานะยินยอม PDPA รายลูกค้า และเปิดโหมดผู้มองว่างเมื่อต้องให้คนอื่นดูหน้าจอของคุณ", href: docs("/customers/pdpa/") },
];
const slides = [
  { src: "/images/app/ai-home.jpg", alt: "หน้าจอผู้ช่วย AI ในแอป Solid Plan บน iPad พร้อมช่องถาม-ตอบและคำถามแนะนำ", caption: "ผู้ช่วย AI พร้อมคำถามแนะนำ เริ่มถามงานได้ทันที" },
  { src: "/images/app/ai_customer_this_week.jpg", alt: "หน้าจอผู้ช่วย AI ในแอป Solid Plan ตอบคำถามว่าสัปดาห์นี้มีลูกค้ารายใดที่ควรติดตาม พร้อมรายชื่อและเหตุผล", caption: "ถามว่า “ลูกค้าในสัปดาห์นี้ควรติดตามคนไหน” ได้รายชื่อพร้อมเหตุผลจากข้อมูลในระบบ" },
  { src: "/images/app/ai_ask_customer_this_month.jpg", alt: "หน้าจอผู้ช่วย AI ในแอป Solid Plan แสดงรายชื่อลูกค้าที่ยังไม่ได้ติดต่อมานานกว่าหนึ่งเดือน เรียงตามวันที่ควรติดตาม", caption: "ขอรายชื่อ “ลูกค้าที่ยังไม่ได้ติดต่อ 1 เดือน” AI ค้นและนับจากฐานลูกค้าทั้งหมดให้" },
  { src: "/images/app/customer.jpg", alt: "หน้าจอรายการลูกค้าในแอป Solid Plan แสดงรูป ชื่อ โน้ตสั้น แท็ก และระดับความสนิทของลูกค้าแต่ละราย", caption: "ฐานลูกค้าทั้งหมดในที่เดียว พร้อมแท็กและระดับความสนิท" },
  { src: "/images/app/calendar.jpg", alt: "หน้าจอปฏิทินรายสัปดาห์ในแอป Solid Plan แสดงนัดหมายและกิจกรรมแยกสีตามขั้นตอนการขาย", caption: "นัดหมายและวันสำคัญในปฏิทินเดียว แยกสีตามขั้นตอนการขาย" },
  { src: "/images/app/customer_target.jpg", alt: "หน้าจอปีเป้าหมายของลูกค้าในแอป Solid Plan แสดงยอดเรียกเก็บ เป้าหมายรายปี และสัดส่วนความคุ้มครองแต่ละแบบประกัน", caption: "ปีเป้าหมายรายลูกค้า เห็นทุนและเบี้ยรวมของทุกกรมธรรม์" },
];
---
<Layout title="ฟีเจอร์ — Solid Plan" description="ผู้ช่วย AI ที่อ่านกรมธรรม์ ตอบจากข้อมูลลูกค้าจริง และบันทึกงานเมื่อคุณยืนยัน พร้อมเครื่องมือจัดการลูกค้า กรมธรรม์ ปฏิทิน ทีมงาน และยอดขายในที่เดียว">
<section class="shell page-head"><h1>เครื่องมือครบทุกขั้นตอน<br />การดูแลลูกค้า</h1><p>อ่านกรมธรรม์ บันทึกลูกค้า วางแผนนัดหมาย ไปจนถึงติดตามยอดขาย ทำได้ในที่เดียว ใช้งานบน iPad และเว็บเบราว์เซอร์</p><div class="ref-cta-row"><a class="ref-pill" href={signupUrl}>สมัครสมาชิก</a><a class="ref-pill ghost" href={lineUrl}><Line size={18} /> เพิ่มเพื่อนใน LINE</a></div></section>

<section class="content-band soft ai-band"><div class="shell">
  <header class="band-head"><h2>AI ที่ทำงานบนข้อมูลลูกค้าของคุณ</h2><p>ความต่างจาก AI ทั่วไปคือ คุณไม่ต้องคอยป้อนข้อมูลให้ AI รู้จักลูกค้า ผู้ช่วย AI ของ Solid Plan ใช้ข้อมูลที่อยู่ในระบบของคุณตอบคำถาม และบันทึกงานให้เมื่อแค่คุณสั่ง</p></header>
  <div class="ai-points">{aiPoints.map(point => <div class="ai-point"><span class="ai-icon" aria-hidden="true" set:html={ICONS[point.icon]} /><b>{point.title}</b><p>{point.text}</p></div>)}</div>
  <div class="ipad-wrap">
    <p class="ipad-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2.5" /><path d="M12 17.6h.01" /></svg>หน้าจอการใช้งานจริงบน iPad</p>
    <div class="ipad-stage" data-slideshow>
      <figure class="ipad">
        <span class="ipad-cam" aria-hidden="true"></span>
        <div class="ipad-screen">
          {slides.map((slide, i) => <img class:list={["slide", { "is-active": i === 0 }]} src={slide.src} alt={slide.alt} data-caption={slide.caption} width="1600" height="1078" loading={i === 0 ? "eager" : "lazy"} aria-hidden={i === 0 ? "false" : "true"} />)}
          <span class="slide-glare" aria-hidden="true"></span>
        </div>
        <button class="slide-nav prev" type="button" aria-label="ภาพก่อนหน้า"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
        <button class="slide-nav next" type="button" aria-label="ภาพถัดไป"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
        <div class="slide-dots" role="group" aria-label="เลือกภาพ">{slides.map((slide, i) => <button class:list={["dot", { "is-active": i === 0 }]} type="button" aria-label={`ดูภาพที่ ${i + 1}`} aria-current={i === 0 ? "true" : "false"}></button>)}</div>
      </figure>
    </div>
    <p class="slide-caption" data-slide-caption>{slides[0].caption}</p>
  </div>
</div></section>

<section class="content-band"><div class="shell split"><div><h2>จาก PDF สู่ข้อมูลกรมธรรม์</h2><p>แนบกรมธรรม์ให้ผู้ช่วย AI อ่าน เตรียมข้อมูลให้ตรวจ แล้วคุณจึงกดยืนยันสร้างรายการ</p><ul class="feature-list"><li>ตรวจแบบประกัน ทุนประกัน และเบี้ยประกัน</li><li>ตรวจวันสำคัญและสัญญาเพิ่มเติม</li><li>แยกข้อมูลที่อ่านได้ ช่องที่ไม่พบ และค่าเริ่มต้นของระบบ</li></ul></div><div class="product-example"><div class="example-header"><b>ยืนยันการสร้างกรมธรรม์</b></div><div class="example-body"><p class="example-question">เพิ่มกรมธรรม์ให้คุณกานต์ พูนสุข จากไฟล์แนบ</p><dl><div><dt>ลูกค้า</dt><dd>คุณกานต์ พูนสุข</dd></div><div><dt>แบบประกัน</dt><dd>ตลอดชีพ ชำระเบี้ย 20 ปี</dd></div><div><dt>เบี้ยประกัน</dt><dd>24,000 บาท / ปี</dd></div><div><dt>ทุนประกัน</dt><dd>1,000,000 บาท</dd></div><div><dt>วันเริ่มสัญญา</dt><dd>18 กันยายน 2569</dd></div><div><dt>ข้อมูลบางช่อง</dt><dd>ไม่พบในเอกสาร</dd></div></dl><div class="example-status">รอผู้ใช้ตรวจและยืนยัน · ยังไม่ได้บันทึก</div></div></div></div></section>

<section class="content-band soft"><div class="shell split rev"><div><h2>ถามข้อมูลก่อนเข้าพบลูกค้า</h2><p>ให้ AI ค้นและสรุปข้อมูลลูกค้า กรมธรรม์ และประวัติการติดต่อจากข้อมูลที่คุณมีในระบบ</p><p>ตรวจทานข้อมูลกับรายการลูกค้าก่อนนำไปใช้ โดยเฉพาะความคุ้มครองและตัวเลขทางการเงิน</p></div><div class="product-example"><div class="example-header"><b>ผู้ช่วย AI</b></div><div class="example-body"><p class="example-question">สรุปคุณกานต์ให้หน่อย บ่ายนี้จะเข้าพบ</p><strong>คุณกานต์ พูนสุข · 2 กรมธรรม์</strong><dl><div><dt>ตลอดชีพ</dt><dd>เบี้ย 24,000 บาท / ปี</dd></div><div><dt>สุขภาพ</dt><dd>เบี้ย 18,500 บาท / ปี</dd></div><div><dt>คุยล่าสุด</dt><dd>สนใจเพิ่มความคุ้มครองโรคร้ายแรง</dd></div></dl></div></div></div></section>

<section class="content-band"><div class="shell split"><div><h2>เพิ่ม แก้ไข และลบ<br />โดยคุณเป็นคนยืนยัน</h2><p>สั่งงานด้วยภาษาที่ใช้คุยกัน ผู้ช่วย AI เตรียมการเปลี่ยนแปลงให้ตรวจ ก่อนคุณกดยืนยันทุกครั้ง</p><ul class="feature-list"><li>เพิ่มข้อมูลลูกค้าและกรมธรรม์</li><li>แก้ไขข้อมูลที่ต้องอัปเดต</li><li>ตรวจรายการก่อนยืนยันการลบ</li></ul></div><div class="product-example"><div class="example-header"><b>ตรวจการเปลี่ยนแปลง</b></div><div class="example-body"><p class="example-question">แก้เบอร์โทรของคุณกานต์เป็นเบอร์ใหม่</p><dl><div><dt>รายการ</dt><dd>คุณกานต์ พูนสุข</dd></div><div><dt>ข้อมูลที่เปลี่ยน</dt><dd>เบอร์โทรศัพท์</dd></div><div><dt>ค่าใหม่</dt><dd>เบอร์ที่คุณระบุ</dd></div></dl><div class="example-status">รอผู้ใช้ยืนยันการแก้ไข</div></div></div></div></section>

<section class="content-band soft"><div class="shell split rev feat"><div><h2>ข้อมูลลูกค้าครบ<br />ในหน้าเดียว</h2><p>เก็บทั้งผู้มุ่งหวังและลูกค้าไว้ในที่เดียว เปลี่ยนสถานะได้เมื่อไรก็ได้ ค้นหาและกรองตามแท็ก ระดับความสนิท หรือความคืบหน้าการขาย</p><ul class="feature-list"><li>โน้ตสั้น ๆ เรื่องลูกค้า เช่น งาน ครอบครัว งานอดิเรก</li><li>บันทึกกิจกรรมทุกการติดต่อ พร้อมขั้นตอนการขาย</li><li>แนบไฟล์เอกสารและรูปภาพไว้กับตัวลูกค้า</li><li>บันทึกสถานะยินยอม PDPA รายบุคคล</li></ul><a class="docs-link" href={docs("/customers/overview/")} target="_blank" rel="noopener noreferrer">อ่านวิธีใช้งานลูกค้าในคู่มือ <ExternalLink size={15} /></a></div><figure class="shot"><img src="/images/app/customer_detail.jpg" alt="หน้าจอรายการลูกค้าในแอป Solid Plan ฝั่งซ้ายเป็นรายชื่อพร้อมแท็กและความคืบหน้า ฝั่งขวาเป็นข้อมูลลูกค้า ความสนิท โน้ต และประวัติกิจกรรม" width="1600" height="1078" loading="lazy" /><figcaption>รายการลูกค้าพร้อมแท็กและความคืบหน้า กดดูรายละเอียดได้ทันที</figcaption></figure></div></section>

