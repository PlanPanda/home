  .app-head svg { width:18px; height:18px; fill:none; stroke:#9da6ad; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .app-head b { flex:1; font-size:15px; font-weight:600; }
  .app-thread { flex:1; min-height:0; overflow:hidden; display:flex; flex-direction:column; gap:12px; padding:20px max(24px, calc((100% - 720px) / 2)); }
  .app-composer { margin:0 20px 16px; border:1px solid #e3e5ea; border-radius:18px; background:#fafafa; padding:8px 8px 5px; }
  .composer-row { display:flex; align-items:center; gap:10px; padding:2px 4px; }
  .composer-add { display:grid; place-items:center; width:30px; height:30px; border:1px solid #d9dbe0; border-radius:50%; background:#fff; }
  .composer-add svg { width:15px; height:15px; fill:none; stroke:#6e6e73; stroke-width:2; stroke-linecap:round; }
  .composer-ph { flex:1; min-width:0; color:#8e8e93; font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .composer-ph.typing { color:#111; }
  .composer-ph.typing::after { content:""; display:inline-block; width:2px; height:15px; margin-left:2px; vertical-align:-2.5px; background:#111; animation:sp-caret 1.1s steps(1) infinite; }
  .composer-file { display:inline-flex; flex:none; align-items:center; gap:5px; padding:3px 9px; border:1px solid #e5e5ea; border-radius:8px; background:#fff; color:#6e6e73; font-size:11.5px; }
  .composer-file svg { width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .composer-send { display:grid; place-items:center; width:32px; height:32px; border-radius:50%; background:#111; }
  .composer-send svg { width:16px; height:16px; fill:none; stroke:#fff; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .composer-mode { display:flex; justify-content:flex-end; align-items:center; gap:5px; padding:5px 10px 5px; color:#9da6ad; font-size:11.5px; }
  .composer-mode svg { width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  .composer-mode svg.tiny { width:10px; height:10px; }

