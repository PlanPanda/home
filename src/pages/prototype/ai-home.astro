---
// Homepage prototype (variant C direction) on /prototype/ai-home.
const lineUrl = "https://line.me/R/ti/p/@675lurmh";
const signupUrl = "https://app.solidplan.ai/signup";
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="ต้นแบบหน้าเว็บ Solid Plan สำหรับทดสอบแนวทางการออกแบบ" />
    <title>Solid Plan AI — Homepage Prototype</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="variant-c">
      <nav class="ref-nav" aria-label="เมนูหลักของ Solid Plan">
        <div class="shell">
          <a class="ref-brand" href="#ref-top"><img src="/brand/logo-192.png" alt="" width="28" height="28" /><strong>Solid Plan</strong></a>
          <div class="ref-links">
            <a href="#ref-demo">ฟีเจอร์</a>
            <a href="#ref-trust">ความไว้วางใจ</a>
            <a href="#ref-pricing">ราคา</a>
            <a class="active" href="#ref-demo" aria-current="page">iPad App</a>
            <a href="#ref-contact">ติดต่อเรา</a>
            <a href="https://docs.solidplan.ai" target="_blank" rel="noopener noreferrer">คู่มือ ↗</a>
          </div>
          <a class="ref-login" href="https://app.solidplan.ai/login">เข้าสู่ระบบ</a>
        </div>
      </nav>

      <section class="ref-hero" id="ref-top">
        <div class="shell ref-hero-copy">
          <h1>จำลูกค้าได้ทุกคน<br />โดยที่คุณไม่ต้องจดเอง</h1>
          <p class="ref-hero-lead">AI ทั่วไปไม่รู้จักลูกค้าคุณ แต่ Solid Plan รู้จักทุกคน</p>
          <p class="ref-hero-sub">ตอนนี้ข้อมูลลูกค้ากระจายอยู่ในโน้ต Line และไฟล์ ทำให้ทุกครั้งที่อยากให้ AI ช่วย คุณต้องไล่หาข้อมูลมาป้อนเอง และยิ่งป้อนมาก AI ก็ยิ่งสับสน Solid Plan เก็บข้อมูลลูกค้าไว้ในระบบประกันของคุณ AI ดึงเฉพาะส่วนที่เกี่ยวกับคำถามมาตอบ และบันทึกให้เมื่อแค่คุณสั่ง</p>
          <div class="ref-cta-row">
            <a class="ref-pill" href={lineUrl}>เพิ่มเพื่อนใน LINE <span aria-hidden="true">↗</span></a>
            <a class="ref-pill ghost" href={signupUrl}>สมัครสมาชิก</a>
          </div>
          <small>เริ่มต้นจากการคุยกันสั้น ๆ แล้วดูการทำงานจริงของ Solid Plan</small>
        </div>

        <div class="ref-stage" id="ref-demo">
          <div class="ipad" aria-label="ตัวอย่างแอป Solid Plan บน iPad">
            <span class="ipad-cam" aria-hidden="true"></span>
            <div class="ipad-screen">
              <div class="app">
                <aside class="app-rail" aria-label="เมนูในแอป (ตัวอย่าง)">
                  <img class="rail-logo" src="/brand/logo-192.png" alt="" width="26" height="26" />
                  <div class="rail-menu">
                    <span class="rail-item on"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg>ผู้ช่วย AI</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>ลูกค้า</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>ปฏิทิน</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 20a6 6 0 0 0-12 0"></path><circle cx="12" cy="10" r="4"></circle><circle cx="12" cy="12" r="10"></circle></svg>ทีมงาน</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>ยอดขาย</span>
                  <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 17V9"></path><path d="M12 17V5"></path><path d="M6 17v-3"></path></svg>รายงาน</span>
                    <span class="rail-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>ตั้งค่า</span>
                  </div>
                  <span class="rail-me" aria-hidden="true">ก</span>
                </aside>
                <div class="app-main">
                  <header class="app-head">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M9 3v18"></path></svg>
                    <b>ผู้ช่วย AI</b>
                    <svg class="head-plus" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>
                  </header>
                  <div class="app-thread" data-thread role="log" aria-live="polite"></div>
                  <div class="app-composer" aria-hidden="true">
                    <div class="composer-row">
                      <span class="composer-add"><svg viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></span>
                      <span class="composer-file" data-composer-file hidden></span>
                      <span class="composer-ph" data-composer-text>ถามผู้ช่วย AI…</span>
                      <span class="composer-send"><svg viewBox="0 0 24 24"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="ref-stage-cap">ใช้งานได้บน iPad และเว็บเบราว์เซอร์</p>
          <div class="ref-scenarios" aria-label="เลือกตัวอย่างการใช้งาน">
            <button type="button" aria-pressed="true" data-ref-scenario="upload"><span>อัปโหลดกรมธรรม์</span><i class="scenario-progress" aria-hidden="true"></i></button>
            <button type="button" aria-pressed="false" data-ref-scenario="summary"><span>สรุปลูกค้า</span><i class="scenario-progress" aria-hidden="true"></i></button>
            <button type="button" aria-pressed="false" data-ref-scenario="add"><span>เพิ่มลูกค้า</span><i class="scenario-progress" aria-hidden="true"></i></button>
            <button type="button" aria-pressed="false" data-ref-scenario="follow"><span>ใครควรติดตาม</span><i class="scenario-progress" aria-hidden="true"></i></button>
          </div>
        </div>
      </section>

      <section class="ref-before-after" id="ref-before-after">
        <div class="shell">
          <header><h2>ใช้ AI กับงานประกัน<br />ทำไมยังไม่ลื่น</h2><p>เพราะข้อมูลลูกค้ายังกระจายอยู่หลายที่ คุณจึงต้องเป็นทั้งคนจด คนค้น และคนป้อนข้อมูลเอง</p></header>
          <article class="ref-pair">
            <span class="ref-pair-tag">01 · จดเอง</span>
            <h3>ได้กรมธรรม์มาแล้ว ต้องนั่งพิมพ์ลงฟอร์มเองทีละช่อง</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <div class="ref-docform" aria-hidden="true">
                  <div class="ref-paper"><span>PDF</span><i></i><i></i><i></i><i></i><i></i></div>
                  <div class="ref-form">
                    <div class="ref-form-h">เพิ่มกรมธรรม์ใหม่</div>
                    <div class="ref-field"><span>แบบประกัน</span><b>ตลอดชีพ ชำระ 20 ปี</b></div>
                    <div class="ref-field"><span>ทุนประกันชีวิต</span><b>1,000,000</b></div>
                    <div class="ref-field"><span>เบี้ยประกัน</span><b>24,000/ปี</b></div>
                    <div class="ref-field"><span>เลขกรมธรรม์</span><i class="ref-caret"></i></div>
                    <div class="ref-field"><span>วันเริ่มสัญญา</span><em>ยังไม่ได้กรอก</em></div>
                  </div>
                </div>
                <small>เปิดกรมธรรม์แล้วพิมพ์ลงฟอร์มทีละช่อง</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <div class="ref-handoff" aria-hidden="true">
                  <span class="ref-filechip"><svg viewBox="0 0 24 24"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path></svg>policy-sample.pdf</span>
                  <div class="ref-answer">
                    <strong>AI จดให้แล้ว 5 ช่อง</strong>
                    <span>แบบประกัน · ทุน · เบี้ย · เลขกรมธรรม์ · วันเริ่มสัญญา</span>
                    <span>เหลือแค่ตรวจ แล้วกดบันทึก</span>
                  </div>
                </div>
                <small>โยน PDF เข้ามา AI อ่านและจดให้ แค่ตรวจแล้วกดบันทึก</small>
              </section>
            </div>
          </article>

          <article class="ref-pair">
            <span class="ref-pair-tag">02 · ค้นเอง</span>
            <h3>อยากรู้ข้อมูลลูกค้า ต้องไล่หาจากหลายที่</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <div class="ref-notes" aria-hidden="true"><span>ครบชำระเดือนไหน?</span><span>เบี้ย 24k หรือ 36k?</span><span>คุยล่าสุดเรื่องอะไร?</span></div>
                <div class="ref-linesheet" aria-hidden="true">
                  <span class="ref-bub">คุณหมอบอกว่าขอคิดดูก่อนนะคะ</span>
                  <div class="ref-sheet"><span class="hd">ชื่อ</span><span class="hd">เบี้ย</span><span class="hd">ครบชำระ</span><span>คุณสมชาย</span><span>24,000</span><span>?</span><span>คุณสมศักดิ์</span><span>36,000</span><span>15 พ.ย.</span></div>
                </div>
                <small>โน้ตแปะ ข้อความ Line และตาราง Excel</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <p class="ref-question">คุณกานต์มีกรมธรรม์อะไรบ้าง?</p>
                <div class="ref-answer"><strong>พบ 2 กรมธรรม์</strong><span>ตลอดชีพ · เบี้ย 24,000 บาท/ปี</span><span>สุขภาพ · เบี้ย 18,500 บาท/ปี</span></div>
                <small>ถามแล้วได้คำตอบจากข้อมูลจริงในระบบ</small>
              </section>
            </div>
          </article>

          <article class="ref-pair">
            <span class="ref-pair-tag">03 · ป้อนข้อมูลให้ AI</span>
            <h3>อยากให้ AI ช่วย ต้องก๊อปข้อมูลไปวางทุกครั้ง</h3>
            <div>
              <section class="ref-before">
                <b>ตอนนี้</b>
                <div class="ref-copy-files" aria-hidden="true"><span>ลูกค้า_วิชัย.xlsx</span><span>ลูกค้า_นภา.xlsx</span><span>ลูกค้า_สมชาย.xlsx</span><span>…อีกหลายไฟล์</span></div>
                <div class="ref-table" aria-hidden="true">
                  <div class="rt-h"><span>ชื่อ</span><span>กรมธรรม์</span><span>ติดต่อล่าสุด</span><span>วันเกิด</span></div>
                  <div class="rt-r"><span>คุณวิชัย</span><span>ตลอดชีพ</span><span>12 ต.ค.</span><span>3 พ.ย.</span></div>
                  <div class="rt-r"><span>คุณนภา</span><span>สุขภาพ</span><span>8 ต.ค.</span><span>21 ต.ค.</span></div>
                  <div class="rt-r"><span>คุณสมชาย</span><span>สะสมทรัพย์</span><span>3 ต.ค.</span><span>2 พ.ย.</span></div>
                  <div class="rt-r"><span>คุณมาลี</span><span>โรคร้ายแรง</span><span>27 ก.ย.</span><span>14 พ.ย.</span></div>
                  <div class="rt-r"><span>คุณสมศักดิ์</span><span>อุบัติเหตุ</span><span>19 ก.ย.</span><span>9 พ.ย.</span></div>
                  <div class="rt-r"><span>คุณธนา</span><span>ตลอดชีพ</span><span>15 ก.ย.</span><span>27 ต.ค.</span></div>
                  <div class="rt-more">…อีก 306 แถว</div>
                </div>
                <div class="ref-qchips" aria-hidden="true"><span>ใครยังไม่ได้ติดต่อ?</span><span>เดือนนี้ใครเกิด?</span></div>
                <small>เปิด Excel หลายไฟล์ แล้วก๊อปข้อมูลไปวางให้ AI ทุกครั้ง ยิ่งป้อนมาก AI ยิ่งสับสน</small>
              </section>
              <section class="ref-after">
                <b>กับ Solid Plan</b>
                <p class="ref-question">เดือนนี้ใครเกิดบ้าง และสัปดาห์นี้ควรติดต่อใคร?</p>
                <div class="ref-answer"><strong>ค้นและนับจากลูกค้า 312 รายในระบบ</strong><span>วันเกิดเดือนนี้ 5 ราย</span><span>ควรติดต่อสัปดาห์นี้ 3 ราย · เหตุผลและประวัติดูได้ครบ</span></div>
                <small>AI รู้จักลูกค้าของคุณอยู่แล้ว ไม่ต้องป้อนซ้ำ</small>
              </section>
            </div>
          </article>
        </div>
      </section>

      <section class="ref-trust" id="ref-trust">
        <div class="shell">
          <header class="ref-trust-head">
            <span class="ref-pair-tag">ความไว้วางใจ</span>
            <h2>ข้อมูลลูกค้าสำคัญ<br />จึงต้องมีระบบที่ตรวจสอบได้</h2>
            <p>Solid Plan ใช้ Railway เป็นผู้ให้บริการโครงสร้างพื้นฐาน และออกแบบการทำงานให้คุณเห็นและยืนยันทุกการบันทึกข้อมูล</p>
          </header>
          <div class="ref-trust-grid">
            <article><span>01</span><h3>โครงสร้างพื้นฐานระดับสากล</h3><p>ข้อมูลของคุณจัดเก็บบนโครงสร้างพื้นฐานของ Railway ซึ่งเผยแพร่ข้อมูลมาตรฐาน SOC 2 Type 2 ไว้ใน Trust Center</p></article>
            <article><span>02</span><h3>คุณเป็นคนควบคุมข้อมูล</h3><p>AI ช่วยค้น สรุป และเตรียมรายการให้ แต่การเพิ่ม แก้ไข หรือลบข้อมูลต้องให้คุณกดยืนยันก่อนเสมอ</p></article>
            <article><span>03</span><h3>ตรวจสอบได้ทุกขั้นตอน</h3><p>คำตอบของ AI แสดงที่มาจากข้อมูลลูกค้าในระบบ ช่วยให้คุณตรวจทานก่อนนำไปใช้คุยกับลูกค้า</p></article>
          </div>
          <a class="ref-trust-link" href="/security-privacy">ดูรายละเอียด Security &amp; Privacy ↗</a>
        </div>
      </section>

      <span id="ref-pricing" class="anchor-target" aria-hidden="true"></span>
      <section class="ref-final" id="ref-contact"><div class="shell"><h2>จำลูกค้าได้ทุกคน<br />โดยที่คุณไม่ต้องจดเอง</h2><div class="ref-cta-row center"><a class="ref-pill inverse" href={lineUrl}>เพิ่มเพื่อนใน LINE <span aria-hidden="true">↗</span></a><a class="ref-pill ghost inverse" href={signupUrl}>สมัครสมาชิก</a></div><p>เริ่มต้นจัดการลูกค้าทุกคนไว้ในที่เดียว</p></div></section>

      <footer class="ref-footer">
        <div class="shell ref-footer-grid">
          <div><div class="ref-footer-brand"><img src="/favicon/web-app-manifest-512x512.png" alt="Solid Plan" width="24" height="24" /><strong>Solid Plan</strong></div><p>เครื่องมือจัดการงานขายและทีมงาน<br />สำหรับตัวแทนประกันยุคใหม่</p></div>
          <div><h3>สินค้า</h3><a href="#ref-demo">ฟีเจอร์</a><a href="#ref-pricing">ราคา</a><a href="#ref-demo">iPad App</a></div>
          <div><h3>บริษัท</h3><a href="/security-privacy">Security &amp; Privacy</a><a href="/terms-of-service">Terms of Service</a><a href="/privacy-policy">Privacy Policy</a></div>
          <div><h3>ช่วยเหลือ</h3><a href="https://docs.solidplan.ai" target="_blank" rel="noopener noreferrer">คู่มือการใช้งาน ↗</a><a href={lineUrl}>ติดต่อเราผ่าน LINE</a></div>
        </div>
        <div class="shell ref-footer-bottom"><span>© 2024 Solid Plan. รายได้ที่ดี มาจากระบบ.</span><span><a href="https://www.facebook.com/solidplanai">Facebook</a><a href={lineUrl}>Line OA</a></span></div>
      </footer>
    </main>

    <script>
      /* Variant C — animated chat demo (scripted, fictional data only) */
      const cThread = document.querySelector("[data-thread]");
      if (cThread) {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let runId = 0;
        let cycleTimer = 0;
        const scenarioKeys = ["upload", "summary", "add", "follow"];

        const ICONS = {
          file: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>',
          check: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>',
          chev: '<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>',
        };
        const AVATAR = '<svg class="sp-avatar" viewBox="0 0 160 160" aria-hidden="true"><g class="character"><rect class="body" x="28" y="28" width="104" height="104" rx="28"></rect><g class="face"><g class="normal"><rect class="eye" x="59" y="65" width="9" height="22" rx="4.5"></rect><rect class="eye" x="92" y="65" width="9" height="22" rx="4.5"></rect></g><g class="happy"><path d="M56 81 Q64 65 72 81 M88 81 Q96 65 104 81"></path></g></g></g><g class="dots"><circle cx="48" cy="80" r="8"></circle><circle cx="80" cy="80" r="8"></circle><circle cx="112" cy="80" r="8"></circle></g></svg>';

        const confirmCard = (title, who, secs, note) =>
          `<div class="card-confirm rv"><div class="cc-head"><div><small>รอยืนยัน</small><strong>${title}</strong><p>${who}</p></div><span class="cc-badge" aria-hidden="true">✓</span></div>` +
          secs.map(([label, rows]) => `<div class="cc-sec"><b>${label}</b><div class="cc-rows">${rows.map(([k, v]) => `<p class="cc-row"><span>${k}</span><b>${v}</b></p>`).join("")}</div></div>`).join("") +
          (note ? `<p class="cc-note">${note}</p>` : "") +
          `<div class="cc-actions"><button type="button" class="primary" data-confirm-action>ยืนยันสร้าง</button><button type="button" class="cancel" data-cancel-action>ยกเลิก</button></div><p class="cc-status" data-card-status hidden></p></div>`;

        const SCENARIOS = {
          upload: {
            user: "เพิ่มกรมธรรม์ให้คุณกานต์ พูนสุข จากไฟล์แนบ",
            file: "policy-sample.pdf",
            steps: ["อ่านไฟล์กรมธรรม์", "จับคู่กับลูกค้า: คุณกานต์ พูนสุข", "แยกข้อมูลกรมธรรม์และสัญญาเพิ่มเติม", "ระบุช่องที่ไม่พบในเอกสาร", "เตรียมรายการให้ตรวจก่อนบันทึก"],
            html: confirmCard("ยืนยันการสร้างกรมธรรม์", "ลูกค้า คุณกานต์ พูนสุข", [
              ["ข้อมูลกรมธรรม์", [["บริษัทประกัน", "บริษัทประกันตัวอย่าง จำกัด"], ["แบบประกัน", "ตลอดชีพ ชำระเบี้ย 20 ปี"], ["เลขกรมธรรม์", "SP-2569-001263"]]],
              ["การเงินและวันสำคัญ", [["เบี้ยประกัน", "฿24,000 · รายปี"], ["ทุนประกันชีวิต", "฿1,000,000"], ["วันเริ่มสัญญา", "18 ก.ย. 2569"]]],
              ["สัญญาเพิ่มเติม (2)", [["โรคร้ายแรง · สุขภาพ", "บางช่องยังไม่ระบุ — ดูได้ในหน้าลูกค้า"]]],
            ], "ค่าเริ่มต้นของระบบ (ไม่ใช่ข้อมูลจากเอกสาร): สถานะ มีผลบังคับ · มูลค่าเวนคืน/ซื้อคืน ฿0<br />ผู้ช่วย AI จะขออนุมัติก่อนสร้างกรมธรรม์เสมอ เพราะเป็นข้อมูลการเงิน"),
            done: '<div class="ok"><span><b>บันทึกกรมธรรม์แล้ว</b> เปิดดูได้ในหน้าลูกค้า คุณกานต์ พูนสุข</span></div><p class="src">ข้อมูลสมมติ</p>',
            needsConfirm: true,
          },
          summary: {
            user: "สรุปคุณกานต์ให้หน่อย บ่ายนี้จะเข้าพบ",
            steps: ["ค้นหาลูกค้า: คุณกานต์ พูนสุข", "รวมกรมธรรม์และบันทึกการติดต่อ"],
            html: '<div class="card-answer rv"><p>สรุปให้แล้ว ก่อนเข้าพบบ่ายนี้</p><div class="rec"><div class="rec-h"><b>คุณกานต์ พูนสุข</b><span>42 ปี · เป็นลูกค้าตั้งแต่ 2566</span></div><ul><li><b>ตลอดชีพ ชำระเบี้ย 20 ปี</b>เบี้ย 24,000 บาท/ปี · ครบชำระ 18 ก.ย.</li><li><b>สุขภาพ</b>เบี้ย 18,500 บาท/ปี</li><li><b>ติดตามล่าสุด 3 ต.ค.</b>คุยเรื่องการขยายความคุ้มครองโรคร้ายแรง ยังไม่ตัดสินใจ</li></ul></div><p class="src">ดึงจากข้อมูลลูกค้า 1 ราย · 2 กรมธรรม์ · 4 บันทึก · ข้อมูลสมมติ</p></div>',
          },
          add: {
            user: "เพิ่มคุณมาลี รักเรียน เบอร์ 081-234-5678 นัดคุยพฤหัสนี้บ่ายสอง",
            steps: ["ตรวจว่าไม่มีลูกค้าซ้ำ", "เตรียมสร้างลูกค้าใหม่และนัดหมาย"],
            html: confirmCard("ยืนยันการสร้างลูกค้าใหม่", "ลูกค้า คุณมาลี รักเรียน", [
              ["ข้อมูลลูกค้า", [["ชื่อ–นามสกุล", "คุณมาลี รักเรียน"], ["โทรศัพท์", "081-234-5678"]]],
              ["นัดหมาย", [["เรื่อง", "นัดคุยเรื่องความคุ้มครอง"], ["วันเวลา", "พฤหัสบดี 14:00"]]],
            ], "ทุกการบันทึกต้องกดยืนยันก่อนเสมอ"),
            done: '<div class="ok"><span><b>บันทึกแล้ว</b> ลูกค้าใหม่ คุณมาลี รักเรียน และนัดหมายพฤหัสบดี 14:00</span></div><p class="src">ข้อมูลสมมติ</p>',
            needsConfirm: true,
          },
          follow: {
            user: "สัปดาห์นี้ลูกค้าคนไหนควรติดตามบ้าง?",
            steps: ["ตรวจประวัติการติดต่อและวันสำคัญ", "จัดลำดับรายที่ควรติดต่อก่อน"],
            html: '<div class="card-answer rv"><p>พบ 3 รายที่ควรติดตามสัปดาห์นี้</p><div class="rec"><ul><li><b>1. คุณวิชัย</b>ส่งใบเสนอราคาไปแล้ว 5 วัน ยังไม่ตอบกลับ</li><li><b>2. คุณนภา</b>วันครบชำระเบี้ย 20 ต.ค.</li><li><b>3. คุณธนา</b>นัดเยี่ยมหลังเสร็จเรื่องเคลม</li></ul></div><p class="src">ดึงจากวันครบชำระ นัดหมาย และประวัติการติดต่อ · เปิดดูข้อมูลลูกค้าแต่ละรายได้ · ข้อมูลสมมติ</p></div>',
          },
        };

        const sleep = (ms) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
        const down = () => { cThread.scrollTop = cThread.scrollHeight; };
        const el = (tag, cls) => { const n = document.createElement(tag); if (cls) n.className = cls; return n; };
        const avatarEl = () => { const t = document.createElement("template"); t.innerHTML = AVATAR.trim(); return t.content.firstChild; };
        const fromHTML = (html) => { const t = document.createElement("template"); t.innerHTML = html.trim(); return t.content.firstChild; };
        const composerText = document.querySelector("[data-composer-text]");
        const composerFile = document.querySelector("[data-composer-file]");
        const scenarioButtons = [...document.querySelectorAll("[data-ref-scenario]")];
        const syncScenarioButtons = (key, waiting = false) => {
          scenarioButtons.forEach((item) => {
            const active = item.getAttribute("data-ref-scenario") === key;
            item.setAttribute("aria-pressed", String(active));
            item.classList.toggle("is-waiting", active && waiting);
          });
        };
        const resetComposer = () => {
          if (composerText) { composerText.textContent = "ถามผู้ช่วย AI…"; composerText.classList.remove("typing"); }
          if (composerFile) composerFile.hidden = true;
        };

        async function playScenario(key) {
          const sc = SCENARIOS[key];
          if (!sc) return;
          const id = ++runId;
          window.clearTimeout(cycleTimer);
          syncScenarioButtons(key);
          cThread.innerHTML = "";
          resetComposer();

          // the question is typed in the composer at the bottom, like a real chat
          if (composerText) {
            composerText.textContent = "";
            composerText.classList.add("typing");
            if (sc.file && composerFile) { composerFile.innerHTML = ICONS.file + sc.file; composerFile.hidden = false; }
            if (reduce) composerText.textContent = sc.user;
            else for (const ch of Array.from(sc.user)) { if (id !== runId) return; composerText.textContent += ch; await sleep(15); }
            await sleep(reduce ? 0 : 320); if (id !== runId) return;
            resetComposer();
          }

          // sent: the bubble appears above the composer with the full text
          const user = el("div", "msg-user");
          if (sc.file) { const f = el("span", "msg-file"); f.innerHTML = ICONS.file + sc.file; user.appendChild(f); }
          const text = el("span");
          text.textContent = sc.user;
          user.appendChild(text);
          cThread.appendChild(user);
          down();
          await sleep(reduce ? 0 : 380); if (id !== runId) return;

          const thinkRow = el("div", "ref-avatar-row");
          const thinking = avatarEl(); thinking.setAttribute("data-state", "thinking");
          thinkRow.appendChild(thinking);
          cThread.appendChild(thinkRow); down();
          await sleep(850); if (id !== runId) return;
          thinkRow.remove();

          const work = el("button", "work");
          work.type = "button"; work.setAttribute("aria-expanded", "false");
          work.innerHTML = '<span class="spin"></span><span>กำลังทำงาน…</span>';
          cThread.appendChild(work); down();
          await sleep(780); if (id !== runId) return;
          work.innerHTML = ICONS.check + `<span>เสร็จสิ้น · ${sc.steps.length} ขั้นตอน</span>` + ICONS.chev;
          const list = el("ul", "steps");
          sc.steps.forEach((s) => { const li = document.createElement("li"); li.textContent = s; list.appendChild(li); });
          list.hidden = !reduce;
          work.setAttribute("aria-expanded", String(reduce));
          work.after(list);
          work.addEventListener("click", () => {
            const open = work.getAttribute("aria-expanded") === "true";
            work.setAttribute("aria-expanded", String(!open));
            list.hidden = open; down();
          });
          await sleep(320); if (id !== runId) return;

          const card = fromHTML(sc.html);
          cThread.appendChild(card);
          requestAnimationFrame(() => card.classList.add("in"));

          const avatar = avatarEl();
          avatar.setAttribute("data-state", sc.needsConfirm ? "waiting" : "normal");
          const row = el("div", "ref-avatar-row");
          row.appendChild(avatar);
          const note = el("span", "ref-avatar-note");
          note.textContent = sc.needsConfirm ? "รอยืนยัน" : "จากข้อมูลในระบบ";
          row.appendChild(note);
          cThread.appendChild(row); down();

          const confirmBtn = card.querySelector("[data-confirm-action]");
          const cancelBtn = card.querySelector("[data-cancel-action]");
          if (confirmBtn) confirmBtn.addEventListener("click", () => {
            if (id !== runId) return;
            const doneWrap = el("div");
            doneWrap.innerHTML = sc.done.trim();
            while (doneWrap.firstChild) card.parentNode.insertBefore(doneWrap.firstChild, card);
            card.remove();
            note.textContent = "บันทึกแล้ว";
            avatar.setAttribute("data-state", "success");
            setTimeout(() => { if (id === runId && avatar.isConnected) avatar.setAttribute("data-state", "normal"); }, 2400);
            down();
          });
          if (cancelBtn) cancelBtn.addEventListener("click", () => {
            const status = card.querySelector("[data-card-status]");
            if (status) { status.hidden = false; status.textContent = "ยกเลิกแล้ว · ยังไม่มีการบันทึกข้อมูล"; }
            confirmBtn?.setAttribute("disabled", "");
            cancelBtn.setAttribute("disabled", "");
            note.textContent = "ยังไม่ได้บันทึก";
            avatar.setAttribute("data-state", "normal");
          });

          const nextKey = scenarioKeys[(scenarioKeys.indexOf(key) + 1) % scenarioKeys.length];
          syncScenarioButtons(key, true);
          cycleTimer = window.setTimeout(() => {
            if (id === runId) playScenario(nextKey);
          }, 3000);
        }

        scenarioButtons.forEach((button) => button.addEventListener("click", () => {
          playScenario(button.getAttribute("data-ref-scenario"));
        }));

        const ipad = document.querySelector(".ipad");
        if (reduce || !("IntersectionObserver" in window) || !ipad) {
          playScenario("upload");
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => { if (entry.isIntersecting) { io.disconnect(); playScenario("upload"); } });
          }, { threshold: 0.35 });
          io.observe(ipad);
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root { --ink:#0a0a0a; --paper:#f7f7f4; --line:#d9d9d4; --muted:#686864; --white:#fff; --soft:#efefeb; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin:0; background:var(--paper); color:var(--ink); font-family:"Sarabun",sans-serif; line-height:1.6; }
  button,a { font:inherit; }
  button { cursor:pointer; }
  a { color:inherit; text-decoration:none; }
  [hidden] { display:none !important; }
  .shell { width:min(1200px, calc(100% - 40px)); margin-inline:auto; }
  .prototype-note { background:#111; color:#fff; text-align:center; font-size:12px; padding:5px 12px; letter-spacing:.02em; }
  /* C — reference-led */
  .variant-c { --ref-hair:#d2d2d7; --ref-soft:#f5f5f7; --ref-edge:#ececf0; background:#fff; color:#1d1d1f; }
  .variant-c :focus-visible { outline:2px solid #111; outline-offset:2px; border-radius:8px; }
  .ref-nav { position:sticky; top:0; z-index:20; background:rgba(255,255,255,.86); backdrop-filter:saturate(180%) blur(18px); border-bottom:1px solid rgba(0,0,0,.08); }
  .ref-nav .shell { min-height:58px; display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:24px; }
  .ref-brand { display:flex; align-items:center; gap:9px; font-size:17px; }
  .ref-brand img { border-radius:7px; }
  .ref-links { display:flex; align-items:center; justify-content:center; gap:20px; min-width:0; color:#6e6e73; font-size:13px; }
  .ref-links a { white-space:nowrap; }
  .ref-links a:hover,.ref-links a.active { color:#1d1d1f; }
  .ref-links a.active { font-weight:600; }
  .ref-login { color:#1d1d1f; font-weight:600; white-space:nowrap; }
  .ref-pill { display:inline-flex; align-items:center; justify-content:center; gap:12px; min-height:48px; padding:0 24px; border-radius:999px; background:#1d1d1f; color:#fff; font-weight:600; }
  .ref-pill:hover { background:#000; }
  .ref-pill.small { min-height:38px; padding:0 18px; font-size:14px; }
  .ref-pill.ghost { background:#fff; color:#1d1d1f; border:1px solid var(--ref-hair); }
  .ref-pill.ghost:hover { background:var(--ref-soft); }
  .ref-pill.inverse { background:#fff; color:#000; }
  .ref-pill.ghost.inverse { background:transparent; color:#fff; border-color:#48484a; }
  .ref-pill.ghost.inverse:hover { background:#1c1c1e; }
  .ref-hero { padding-top:74px; text-align:center; overflow:hidden; }
  .ref-hero-copy h1 { margin:0; font-size:clamp(44px,6vw,76px); line-height:1.22; letter-spacing:-.02em; text-wrap:balance; }
  .ref-hero-lead { max-width:820px; margin:26px auto 0; color:#1d1d1f; font-size:clamp(19px,2.6vw,25px); font-weight:600; line-height:1.55; }
  .ref-hero-sub { max-width:780px; margin:16px auto 26px; color:#6e6e73; font-size:clamp(14px,1.55vw,16px); line-height:1.75; }
  .ref-cta-row { display:flex; flex-wrap:wrap; gap:10px 14px; justify-content:center; align-items:center; margin-top:6px; }
  .ref-cta-row.center { margin:34px 0 0; }
  .ref-hero-copy small { display:block; margin-top:15px; color:#6e6e73; }

  /* iPad stage */
  .ref-stage { width:min(900px, calc(100% - 24px)); margin:52px auto 0; text-align:left; }
  .ipad { position:relative; aspect-ratio:1.4 / 1; background:#101013; border-radius:34px; padding:18px 22px; box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.09), 0 2px 6px rgba(0,0,0,.18), 0 70px 120px -55px rgba(0,0,0,.55); }
  .ipad-cam { position:absolute; left:10px; top:50%; transform:translateY(-50%); width:7px; height:7px; border-radius:50%; background:#2a2a30; box-shadow:inset 0 0 2px #000; }
  .ipad-screen { height:100%; overflow:hidden; border-radius:17px; background:#eef1f6; }
  .ref-stage-cap { margin:16px 0 0; text-align:center; color:#6e6e73; font-size:13px; }

  /* app mockup (matches Smart app default theme: black accent, Sarabun) */
  .app { display:grid; grid-template-columns:74px minmax(0,1fr); grid-template-rows:minmax(0,1fr); height:100%; }
  .app-rail { display:flex; flex-direction:column; align-items:center; padding:12px 5px 14px; background:#f7f8fa; border-right:1px solid var(--ref-edge); }
  .rail-logo { margin-bottom:8px; border-radius:6px; }
  .rail-menu { display:flex; flex:1; flex-direction:column; justify-content:center; align-items:center; gap:4px; width:100%; }
  .rail-item { display:flex; flex-direction:column; align-items:center; gap:3px; width:62px; padding:7px 0 6px; border-radius:12px; font-size:9.5px; line-height:1.25; color:#6e6e73; }
  .rail-item svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .rail-item.on { background:#f0f0f0; color:#111; font-weight:600; }
  .rail-me { margin-top:auto; display:grid; place-items:center; width:27px; height:27px; border-radius:50%; background:#111; color:#fff; font-size:12px; }
  .app-main { min-width:0; display:flex; flex-direction:column; background:#fff; }
