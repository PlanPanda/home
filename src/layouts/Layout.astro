---
import '../styles/site.css';
import ExternalLink from '../components/icons/ExternalLink.astro';
import Line from '../components/icons/Line.astro';
const { title = "Solid Plan — ผู้ช่วย AI สำหรับตัวแทนประกัน", description = "รวมข้อมูลลูกค้าและกรมธรรม์ไว้ในที่เดียว ให้ AI ช่วยอ่าน ค้นหา และเตรียมข้อมูล โดยคุณยืนยันก่อนบันทึก", draft = false } = Astro.props;
const links = [{href:"/features",label:"ฟีเจอร์"},{href:"/pricing",label:"ราคา"},{href:"/security-privacy",label:"การดูแลข้อมูล"},{href:"https://docs.solidplan.ai/",label:"คู่มือการใช้งาน",external:true}];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {draft && <meta name="robots" content="noindex,nofollow" />}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
  <link rel="manifest" href="/favicon/site.webmanifest" />
  <meta name="theme-color" content="#eef1f6" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#main">ข้ามไปเนื้อหา</a>
  <header class="site-header">
    <nav class="shell nav-inner" aria-label="เมนูหลัก">
      <a class="brand" href="/"><img src="/brand/logo-192.png" alt="" width="32" height="32" /><strong>Solid Plan</strong></a>
      <div class="nav-links">{links.map(link => <a href={link.href} aria-current={path===link.href ? "page" : undefined} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}>{link.label}{link.external && <span class="ext"><ExternalLink size={13} /></span>}</a>)}</div>
      <div class="nav-auth"><a class="login" href="https://app.solidplan.ai/login">เข้าสู่ระบบ</a><a class="nav-signup" href="https://app.solidplan.ai/signup">สมัครสมาชิก</a></div>
    </nav>
  </header>
  <main id="main" class="variant-c"><slot /></main>
  <footer class="site-footer">
    <div class="shell footer-grid">
      <div><a class="brand" href="/"><img src="/brand/logo-192.png" alt="" width="32" height="32" /><strong>Solid Plan</strong></a><p>ผู้ช่วย AI สำหรับตัวแทนประกัน<br />ให้เวลากับการดูแลลูกค้ามากขึ้น</p></div>
      <div><h2>Solid Plan</h2><a href="/features">ฟีเจอร์</a><a href="/pricing">ราคา</a><a href="https://app.solidplan.ai/signup">สมัครสมาชิก</a></div>
      <div><h2>ข้อมูลและเงื่อนไข</h2><a href="/security-privacy">การดูแลข้อมูล</a><a href="/privacy-policy">นโยบายความเป็นส่วนตัว</a><a href="/terms-of-service">ข้อกำหนดการใช้งาน</a></div>
      <div><h2>ติดต่อ</h2><a href="https://line.me/R/ti/p/@675lurmh" class="line-link"><Line size={15} /> เพิ่มเพื่อนใน LINE</a><a href="mailto:apirak@solidplan.ai">apirak@solidplan.ai</a><a href="https://docs.solidplan.ai" target="_blank" rel="noopener noreferrer">คู่มือการใช้งาน</a></div>
    </div>
    <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Solid Plan</span><span>ให้บริการโดย ทีมงาน SolidPlan</span></div>
  </footer>
</body>
</html>
